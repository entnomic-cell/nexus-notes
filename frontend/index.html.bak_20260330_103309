function mmUpdateMeta(key,value){
  mmMeta[key]=value;
  if(key==='layoutMode' && value==='tree'){
    mmMeta.autoLayout=true;
    mmCommitChange({autoLayout:true});
    return;
  }
  if(key==='layoutMode' && value==='manual'){
    mmMeta.autoLayout=false;
  }
  mmCommitChange({autoLayout:key==='layoutMode'&&value==='tree'});
}

function getMmNodeMetrics(){
  const size=mmMeta.nodeSize||'md';
  if(size==='sm')return {width:110,height:44};
  if(size==='lg')return {width:180,height:66};
  return {width:138,height:52};
}

function buildMmEdgeMarkup(e){
  const a=mmNodes.find(n=>n.id===e.from),b=mmNodes.find(n=>n.id===e.to);
  if(!a||!b)return '';
  const muted=mmMeta.focusNodeId && mmMeta.focusNodeId!==e.from && mmMeta.focusNodeId!==e.to ? ' opacity="0.25"' : '';
  const dash=mmMeta.edgeStyle==='solid'?'':' stroke-dasharray="4"';
  if(mmMeta.edgeStyle==='curved'){
    const cx=(a.x+b.x)/2;
    return `<path d="M ${a.x} ${a.y} C ${cx} ${a.y}, ${cx} ${b.y}, ${b.x} ${b.y}" stroke="var(--border2)" stroke-width="2" fill="none"${dash}${muted}/>`;
  }
  return `<line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" stroke="var(--border2)" stroke-width="2"${dash}${muted}/>`;
}

function applyMindmapCanvasStyle(canvas){
