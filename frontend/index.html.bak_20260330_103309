        <button class="cal-chip-btn" onclick="createCalendarNote('${dateKey}')">New Note</button>
      </div>
    </div>
    <div class="cal-detail-section">
      <div class="cal-detail-section-title">Schedule</div>
      ${dayEvents.length ? dayEvents.map(eventItem=>`
        <div class="cal-event-card">
          <div class="cal-event-row">
            <div class="cal-event-main">
              <div class="cal-event-accent" style="background:${esc(eventItem.color||'#5b8def')}"></div>
