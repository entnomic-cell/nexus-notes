function updateChecklistProgress(){
  const editor=document.getElementById('editor-content');
  if(!editor)return;
  const checklists=editor.querySelectorAll('ul.task-list');
  checklists.forEach(ul=>{
    const boxes=ul.querySelectorAll('input[type="checkbox"]');
    const checked=ul.querySelectorAll('input[type="checkbox"]:checked');
    if(!boxes.length)return;
    let bar=ul.previousElementSibling;
    let summary=ul.previousElementSibling;
    // inject progress bar above checklist if not present
    const pct=Math.round((checked.length/boxes.length)*100);
    let prog=ul.parentNode.querySelector(`[data-checklist-prog="${Array.from(ul.parentNode.children).indexOf(ul)}"]`);
    if(!prog){
      prog=document.createElement('div');
      prog.className='checklist-progress';
      prog.dataset.checklistProg=Array.from(ul.parentNode.children).indexOf(ul);
      ul.parentNode.insertBefore(prog,ul);
    }
    prog.innerHTML=`<div class="checklist-progress-bar" style="width:${pct}%"></div>`;
    prog.title=`${checked.length}/${boxes.length} done (${pct}%)`;
  });
}

