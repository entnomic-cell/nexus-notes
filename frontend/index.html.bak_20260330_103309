/* ── TABLE TOOLBAR ── */
let _tableToolbarEl = null;
function initTableToolbar(){
  if(_tableToolbarEl) return _tableToolbarEl;
  _tableToolbarEl = document.getElementById('table-toolbar');
  if(_tableToolbarEl) return _tableToolbarEl;
  _tableToolbarEl = document.createElement('div');
  _tableToolbarEl.className = 'table-toolbar';
  _tableToolbarEl.id = 'table-toolbar';
  _tableToolbarEl.innerHTML = `
    <button onclick="tableAddRowAbove()" title="Add Row Above">+ Row Above</button>
    <button onclick="tableAddRowBelow()" title="Add Row Below">+ Row Below</button>
    <button onclick="tableAddColLeft()" title="Add Column Left">+ Col Left</button>
    <button onclick="tableAddColRight()" title="Add Column Right">+ Col Right</button>
    <button onclick="tableDeleteRow()" title="Delete Row" style="color:var(--red)">Del Row</button>
    <button onclick="tableDeleteCol()" title="Delete Column" style="color:var(--red)">Del Col</button>
  `;
  document.body.appendChild(_tableToolbarEl);
  return _tableToolbarEl;
}

let _activeTableCell = null;
function showTableToolbarForCell(cell){
  if(!cell) return;
  _activeTableCell = cell;
  const toolbar = initTableToolbar();
  const r = cell.getBoundingClientRect();
  toolbar.style.top = (r.top - 40 + window.scrollY) + 'px';
  toolbar.style.left = (r.left + window.scrollX) + 'px';
  toolbar.classList.add('visible');
}
document.addEventListener('click', e => {
  const cell = e.target.closest('#editor-content td, #editor-content th');
  if(cell){
    showTableToolbarForCell(cell);
  } else if(_tableToolbarEl && !e.target.closest('#table-toolbar')){
    _tableToolbarEl.classList.remove('visible');
    _activeTableCell = null;
  }
});

function handleTableClick(event){
  const cell = event.target.closest('td,th');
  if(cell) showTableToolbarForCell(cell);
}

function tableAddRow(offset=1){
  if(!_activeTableCell) return;
  const row = _activeTableCell.closest('tr');
  if(!row) return;
  const cols = row.querySelectorAll('td,th').length;
  const newRow = document.createElement('tr');
  for(let i=0;i<cols;i++){
    const td = document.createElement('td');
    td.contentEditable = 'true';
    td.innerHTML = '<br>';
    newRow.appendChild(td);
  }
  row.parentNode.insertBefore(newRow, offset < 0 ? row : row.nextSibling);
  debounceSave();
}
function tableAddCol(offset=1){
  if(!_activeTableCell) return;
  const table = _activeTableCell.closest('table');
  if(!table) return;
  const cellIdx = Array.from(_activeTableCell.parentNode.children).indexOf(_activeTableCell);
  table.querySelectorAll('tr').forEach((row,ri)=>{
    const isHeader = ri===0 && row.querySelector('th');
    const cell = document.createElement(isHeader?'th':'td');
    cell.contentEditable = 'true';
    cell.innerHTML = isHeader ? 'Column' : '<br>';
    const ref = offset < 0 ? row.children[cellIdx] : row.children[cellIdx+1];
    row.insertBefore(cell, ref||null);
  });
  debounceSave();
}
function tableAddRowAbove(){tableAddRow(-1);}
function tableAddRowBelow(){tableAddRow(1);}
function tableAddColLeft(){tableAddCol(-1);}
function tableAddColRight(){tableAddCol(1);}
function tableDelRow(){
  if(!_activeTableCell) return;
  const row = _activeTableCell.closest('tr');
  const table = row&&row.closest('table');
  if(!table || table.querySelectorAll('tr').length<=1) return;
  row.remove();
  _activeTableCell=null;
  if(_tableToolbarEl) _tableToolbarEl.classList.remove('visible');
  debounceSave();
}
function tableDelCol(){
  if(!_activeTableCell) return;
  const table = _activeTableCell.closest('table');
  if(!table) return;
  const idx = Array.from(_activeTableCell.parentNode.children).indexOf(_activeTableCell);
  let removed=false;
  table.querySelectorAll('tr').forEach(row=>{
    if(row.children.length>1){ row.children[idx]&&row.children[idx].remove(); removed=true; }
  });
  if(removed){ _activeTableCell=null; if(_tableToolbarEl) _tableToolbarEl.classList.remove('visible'); debounceSave(); }
}
function tableDeleteRow(){tableDelRow();}
function tableDeleteCol(){tableDelCol();}

/* ── IMAGE PASTE FROM CLIPBOARD ── */
function handleEditorPaste(e){
  const items = (e.clipboardData||window.clipboardData||{}).items;
  if(!items) return;
  let hasImage = false;
  for(const item of items){
    if(item.type.startsWith('image/')){
      hasImage = true;
      e.preventDefault();
      const file = item.getAsFile();
      if(!file) continue;
      const reader = new FileReader();
      reader.onload = ev => {
        const dataUrl = ev.target.result;
        focusEditor();
        document.execCommand('insertHTML', false,
          `<img src="${dataUrl}" alt="pasted image" style="max-width:100%;border-radius:var(--r);margin:8px 0;display:block"><p><br></p>`);
        debounceSave();
      };
      reader.readAsDataURL(file);
    }
  }
  // Also handle dropping images onto editor
  if(!hasImage){
    // Let default paste handle text/html
  }
}

// Also handle drag-drop images onto editor
(function(){
  function onEditorDrop(e){
    const files = e.dataTransfer&&e.dataTransfer.files;
    if(!files||!files.length) return;
    let hasImg = false;
    for(const f of files){
      if(f.type.startsWith('image/')){
        hasImg = true;
        e.preventDefault();
        const reader = new FileReader();
        reader.onload = ev => {
          focusEditor();
          document.execCommand('insertHTML',false,
            `<img src="${ev.target.result}" alt="${esc(f.name)}" style="max-width:100%;border-radius:var(--r);margin:8px 0;display:block"><p><br></p>`);
          debounceSave();
        };
        reader.readAsDataURL(f);
      }
    }
  }
  window.addEventListener('DOMContentLoaded',()=>{
    const ed = document.getElementById('editor-content');
    if(ed){
      ed.addEventListener('drop', onEditorDrop);
      ed.addEventListener('dragover', e=>{ if([...( e.dataTransfer.types||[])].includes('Files')) e.preventDefault(); });
    }
  });
})();



