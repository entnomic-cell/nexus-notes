function closeGDrivePanel(){document.getElementById('gdrive-panel').classList.remove('open');}
function isGDriveTokenValid(){return !!gDriveAccessToken && Date.now()<gDriveTokenExpiresAt;}
function syncGDriveUI(){
  document.getElementById('gdrive-auth-area').style.display=gDriveConnected?'none':'block';
  document.getElementById('gdrive-connected-area').style.display=gDriveConnected?'block':'none';
  const input=document.getElementById('gdrive-client-id');
  if(input && gDriveClientId && input.value!==gDriveClientId)input.value=gDriveClientId;
}
function parseGoogleDriveShareLink(raw){
  const input=String(raw||'').trim();
  if(!input)return null;
  try{
    const url=new URL(input);
    const path=url.pathname;
    const patterns=[
      {type:'doc',regex:/\/document\/d\/([^/]+)/},
      {type:'sheet',regex:/\/spreadsheets\/d\/([^/]+)/},
      {type:'slide',regex:/\/presentation\/d\/([^/]+)/},
      {type:'file',regex:/\/file\/d\/([^/]+)/},
      {type:'folder',regex:/\/folders\/([^/]+)/}
    ];
    for(const pattern of patterns){
      const match=path.match(pattern.regex);
      if(match)return {id:match[1],type:pattern.type,url:input};
    }
    const id=url.searchParams.get('id');
    if(id)return {id,type:'file',url:input};
  }catch(_){}
  return null;
}
async function gDriveImportSharedLink(){
  const raw=(document.getElementById('gdrive-share-link')?.value||'').trim();
  const parsed=parseGoogleDriveShareLink(raw);
  if(!parsed){
    showNotif('Paste a valid Google Drive, Docs, Sheets, or Slides link');
    return;
  }
  let title='Google Drive Import';
  let content=`<p><em>Imported from Google Drive shared link</em></p><p><a href="${esc(parsed.url)}" target="_blank" rel="noopener">${esc(parsed.url)}</a></p>`;
  try{
    if(parsed.type==='doc'){
      const resp=await fetch(`https://docs.google.com/document/d/${parsed.id}/export?format=txt`);
      const text=await resp.text();
      if(resp.ok && text.trim()){
        title=text.split('\n').find(Boolean)?.trim()?.slice(0,80)||'Google Doc';
        content=`<p><em>Imported from shared Google Doc</em></p><hr><div>${plainTextToHtml(text)}</div>`;
      }
    }else if(parsed.type==='sheet'){
      const resp=await fetch(`https://docs.google.com/spreadsheets/d/${parsed.id}/export?format=csv`);
      const text=await resp.text();
      if(resp.ok && text.trim()){
        title='Google Sheet';
        content=`<p><em>Imported from shared Google Sheet</em></p><pre><code>${esc(text)}</code></pre>`;
      }
    }else if(parsed.type==='slide'){
      title='Google Slides';
      content=`<p><em>Linked from shared Google Slides</em></p><p><a href="${esc(parsed.url)}" target="_blank" rel="noopener">Open presentation</a></p>`;
    }else if(parsed.type==='folder'){
      title='Google Drive Folder';
      content=`<p><em>Linked from shared Google Drive folder</em></p><p><a href="${esc(parsed.url)}" target="_blank" rel="noopener">Open folder</a></p>`;
    }else{
      title='Google Drive File';
      content=`<p><em>Linked from shared Google Drive file</em></p><p><a href="${esc(parsed.url)}" target="_blank" rel="noopener">Open file</a></p>`;
    }
  }catch(err){
    console.warn('Shared Google Drive import fallback',err);
  }
  const note=await api('POST','/notes',{
    title,
    content,
    folder:'Google Drive',
    tags:['gdrive','shared-link'],
    properties:{...defaultNoteProperties(),source_url:parsed.url,captured_via:'gdrive-shared-link',captured_at:new Date().toISOString()}
  });
  allNotes.unshift(note);
  renderNoteList(allNotes);
  await renderFolders();
  await loadStats();
  await openNote(note.id);
  closeGDrivePanel();
  showNotif('Shared Drive link imported');
}
async function ensureGoogleIdentityLoaded(){
  if(window.google?.accounts?.oauth2)return;
  if(gDriveIdentityPromise)return gDriveIdentityPromise;
  gDriveIdentityPromise=new Promise((resolve,reject)=>{
    const script=document.createElement('script');
    script.src='https://accounts.google.com/gsi/client';
    script.async=true;
    script.defer=true;
    script.onload=resolve;
    script.onerror=()=>reject(new Error('Could not load Google Identity Services'));
    document.head.appendChild(script);
  });
  return gDriveIdentityPromise;
}
function ensureGDriveClientId(){
  const next=(document.getElementById('gdrive-client-id')?.value||'').trim();
  if(!next){
    showNotif('Enter your Google OAuth Client ID first');
    throw new Error('missing Google OAuth Client ID');
  }
  if(next!==gDriveClientId){
    gDriveClientId=next;
    gDriveTokenClient=null;
    api('PUT','/settings',{gDriveClientId}).catch(()=>{});
  }
}
async function requestGDriveAccessToken(forcePrompt=false){
  await ensureGoogleIdentityLoaded();
  ensureGDriveClientId();
  return new Promise((resolve,reject)=>{
    gDriveTokenClient=google.accounts.oauth2.initTokenClient({
      client_id:gDriveClientId,
      scope:'https://www.googleapis.com/auth/drive.readonly',
      callback:(resp)=>{
        if(resp?.error){
          reject(new Error(resp.error));
          return;
        }
        gDriveAccessToken=resp.access_token||'';
        gDriveTokenExpiresAt=Date.now()+Math.max(60000,((resp.expires_in||3600)-60)*1000);
        gDriveConnected=!!gDriveAccessToken;
        syncGDriveUI();
        resolve(resp);
      }
    });
    gDriveTokenClient.requestAccessToken({prompt:forcePrompt || !isGDriveTokenValid() ? 'consent' : ''});
  });
}
async function gDriveAuthorizedFetch(url, opts={}){
  if(!isGDriveTokenValid())await requestGDriveAccessToken(false);
  const resp=await fetch(url,{
    ...opts,
    headers:{
      ...(opts.headers||{}),
      Authorization:`Bearer ${gDriveAccessToken}`
    }
  });
  if(resp.status===401){
    gDriveAccessToken='';
    gDriveConnected=false;
    syncGDriveUI();
    throw new Error('Google Drive session expired');
  }
  if(!resp.ok){
    const text=await resp.text();
    throw new Error(text||`Google Drive request failed (${resp.status})`);
  }
  return resp;
}
function normalizeGDriveFile(file){
  const mime=file.mimeType||'';
  let type='text';
  if(mime==='application/vnd.google-apps.document')type='doc';
  else if(mime==='application/vnd.google-apps.spreadsheet')type='sheet';
  else if(mime==='application/vnd.google-apps.presentation')type='slide';
  else if(mime==='application/vnd.google-apps.folder')type='folder';
  else if(mime==='application/pdf')type='pdf';
  else if(mime.startsWith('image/'))type='image';
  return {
    id:file.id,
    name:file.name||'Untitled',
    type,
    mimeType:mime,
    modified:file.modifiedTime?new Date(file.modifiedTime).toLocaleString(): '',
    url:file.webViewLink||`https://drive.google.com/file/d/${file.id}/view`
  };
}
async function loadGDriveFiles(){
  const query=new URLSearchParams({
    pageSize:'50',
    orderBy:'modifiedTime desc',
    q:"trashed=false",
    fields:'files(id,name,mimeType,modifiedTime,webViewLink)'
  });
  const filesResp=await gDriveAuthorizedFetch(`https://www.googleapis.com/drive/v3/files?${query}`);
  const filesJson=await filesResp.json();
  gDriveFiles=(filesJson.files||[]).map(normalizeGDriveFile);
  renderGDriveFiles(gDriveFiles);
  try{
    const aboutResp=await gDriveAuthorizedFetch('https://www.googleapis.com/drive/v3/about?fields=user(displayName,emailAddress)');
    const about=await aboutResp.json();
    document.getElementById('gdrive-user-label').textContent=[about.user?.displayName,about.user?.emailAddress].filter(Boolean).join(' · ')||'Google Drive connected';
  }catch(_){
    document.getElementById('gdrive-user-label').textContent='Google Drive connected';
  }
}
async function connectGDrive(){
  try{
    if(!isGDriveTokenValid())await requestGDriveAccessToken(true);
    else {gDriveConnected=true;syncGDriveUI();}
    await loadGDriveFiles();
    showNotif('Google Drive connected');
  }catch(err){
    showNotif('Google Drive connection failed');
  }
}
function renderGDriveFiles(files){
  if(!files.length){
    document.getElementById('gdrive-files').innerHTML='<div style="padding:20px 4px;color:var(--text3);font-size:13px;">No Drive files matched this view.</div>';
    return;
  }
  document.getElementById('gdrive-files').innerHTML=files.map(f=>`
    <div class="gdrive-file">
      <div class="gdrive-file-icon">${gDriveIconSvg(f.type)}</div>
      <div class="gdrive-file-name">${esc(f.name)}</div>
      <div class="gdrive-file-meta">${esc(f.modified)}</div>
      <button class="gdrive-act" onclick="gDriveImport('${esc(f.id)}','${esc(f.name)}','${esc(f.type)}')" title="Import as note">Import</button>
      <button class="gdrive-act" onclick="gDriveLink('${esc(f.url)}','${esc(f.name)}')" title="Insert link">Link</button>
      <button class="gdrive-act" onclick="window.open('${esc(f.url)}','_blank','noopener')" title="Open in Drive">Open</button>
    </div>`).join('');
}
function filterGDrive(q){
  const filtered=q?gDriveFiles.filter(f=>f.name.toLowerCase().includes(q.toLowerCase())):gDriveFiles;
  renderGDriveFiles(filtered);
}
async function gDriveImport(id,name,type){
  const file=gDriveFiles.find(f=>f.id===id)||{id,name,type,mimeType:'',url:''};
  let content=`<p><em>Imported from Google Drive</em></p><p><a href="${esc(file.url||'#')}" target="_blank" rel="noopener">${esc(name)}</a></p>`;
  try{
    let text='';
    if(file.mimeType==='application/vnd.google-apps.document'){
      const resp=await gDriveAuthorizedFetch(`https://www.googleapis.com/drive/v3/files/${id}/export?mimeType=text/plain`);
      text=await resp.text();
      content=`<p><em>Imported from Google Docs</em></p><hr><div>${plainTextToHtml(text)}</div>`;
    }else if(file.mimeType==='application/vnd.google-apps.spreadsheet'){
      const resp=await gDriveAuthorizedFetch(`https://www.googleapis.com/drive/v3/files/${id}/export?mimeType=text/csv`);
      text=await resp.text();
      content=`<p><em>Imported from Google Sheets</em></p><pre><code>${esc(text)}</code></pre>`;
    }else if(file.mimeType.startsWith('text/')||['application/json','application/xml'].includes(file.mimeType)){
      const resp=await gDriveAuthorizedFetch(`https://www.googleapis.com/drive/v3/files/${id}?alt=media`);
      text=await resp.text();
      content=file.mimeType.includes('markdown')?markdownToHtml(text):plainTextToHtml(text);
    }else if(file.type==='image'){
      content=`<p><em>Linked from Google Drive</em></p><p><a href="${esc(file.url)}" target="_blank" rel="noopener">${esc(name)}</a></p>`;
    }
  }catch(err){
    content=`<p><em>Google Drive import fallback</em></p><p>${esc(name)}</p><p><a href="${esc(file.url||'#')}" target="_blank" rel="noopener">Open in Google Drive</a></p>`;
  }
  const note=await api('POST','/notes',{title:name,content,folder:'Google Drive',tags:['gdrive']});
  allNotes.unshift(note);renderNoteList(allNotes);await openNote(note.id);
  closeGDrivePanel();showNotif(`"${name}" imported`);
}
function gDriveLink(url,name){
  if(!currentNote){showNotif('Open a note first');return;}
  focusEditor();
  document.execCommand('insertHTML',false,`<a href="${esc(url)}" target="_blank" rel="noopener">${esc(name)}</a><p><br></p>`);
  debounceSave();closeGDrivePanel();showNotif('Link inserted');
}
function disconnectGDrive(){
  gDriveConnected=false;
  gDriveFiles=[];
  gDriveAccessToken='';
  gDriveTokenExpiresAt=0;
  syncGDriveUI();
  showNotif('Google Drive disconnected');
}
