}
function detectShapeAssist(points){
  if(points.length<2)return null;
  const first=points[0],last=points[points.length-1];
  const box={minX:Math.min(...points.map(p=>p.x)),minY:Math.min(...points.map(p=>p.y)),maxX:Math.max(...points.map(p=>p.x)),maxY:Math.max(...points.map(p=>p.y))};
  const width=box.maxX-box.minX,height=box.maxY-box.minY,diag=Math.hypot(width,height),length=pathLength(points);
  const closed=pointDistance(first,last)<Math.max(18,diag*0.18);
  if((ptShapeKind==='line'||ptShapeKind==='auto') && length>0 && pointDistance(first,last)/length>0.92)return normalizeSketchStroke({id:sketchUid('stroke'),type:'shape',tool:'shape',shape:'line',color:ptColor,width:ptBrushSize,opacity:ptOpacity,points:[first,last],timestamp:Date.now()});
