function drawPainterArrow(ctx,x1,y1,x2,y2){
  const headlen=Math.max(10,ptBrushSize*3);
  const angle=Math.atan2(y2-y1,x2-x1);
  ctx.beginPath();
  ctx.moveTo(x1,y1);
  ctx.lineTo(x2,y2);
  ctx.moveTo(x2,y2);
  ctx.lineTo(x2-headlen*Math.cos(angle-Math.PI/6),y2-headlen*Math.sin(angle-Math.PI/6));
  ctx.moveTo(x2,y2);
  ctx.lineTo(x2-headlen*Math.cos(angle+Math.PI/6),y2-headlen*Math.sin(angle+Math.PI/6));
  ctx.stroke();
}

function setupPainterEvents(){
  const canvas=document.getElementById('painter-canvas');
  const ctx=canvas.getContext('2d');
  const getPos=e=>{
    const r=canvas.getBoundingClientRect();
    const sx=canvas.width/r.width,sy=canvas.height/r.height;
    const src=e.touches?e.touches[0]:e;
    return {x:(src.clientX-r.left)*sx,y:(src.clientY-r.top)*sy};
  };
  const startDraw=e=>{
    e.preventDefault();
    const p=getPos(e);ptStartX=p.x;ptStartY=p.y;
    if(ptTool==='text'){
      openQuickSheet({
        title:'Add Text',
        subtitle:'Drop text directly onto the canvas.',
        submitLabel:'Place',
        fields:[{id:'text',label:'Text',placeholder:'Type something'},{id:'size',label:'Size',value:String(ptTextSize)}],
        onSubmit:async({text,size})=>{
          if(!text)return;
          ctx.save();
          ctx.globalAlpha=ptOpacity;
          ctx.fillStyle=ptColor;
          ctx.font=`${Math.max(10,parseInt(size,10)||ptTextSize)}px DM Sans`;
          ctx.textBaseline='top';
          ctx.fillText(text,p.x,p.y);
          ctx.restore();
          ptSaveHistory();
        }
      });
      return;
    }
    ptDrawing=true;
    ptSnapshot=ctx.getImageData(0,0,canvas.width,canvas.height);
    ctx.beginPath();ctx.moveTo(p.x,p.y);
  };
  const draw=e=>{
    if(!ptDrawing)return;e.preventDefault();
    const p=getPos(e);
    ctx.lineWidth=ptBrushSize;ctx.lineCap='round';ctx.lineJoin='round';
    ctx.globalAlpha=ptOpacity;
    if(ptTool==='pen'||ptTool==='brush'){
      ctx.globalCompositeOperation='source-over';
      ctx.strokeStyle=ptColor;
      if(ptTool==='brush'){ctx.globalAlpha=Math.min(1,ptOpacity*0.45);ctx.lineWidth=ptBrushSize*2;}
      ctx.lineTo(p.x,p.y);ctx.stroke();ctx.beginPath();ctx.moveTo(p.x,p.y);
    } else if(ptTool==='eraser'){
      ctx.globalCompositeOperation='destination-out';
      ctx.globalAlpha=1;
      ctx.lineTo(p.x,p.y);ctx.stroke();ctx.beginPath();ctx.moveTo(p.x,p.y);
    } else {
      // Shape preview
      ctx.putImageData(ptSnapshot,0,0);
      ctx.globalCompositeOperation='source-over';ctx.globalAlpha=ptOpacity;
      ctx.strokeStyle=ptColor;ctx.fillStyle=ptColor+'33';
      if(ptTool==='line'){ctx.beginPath();ctx.moveTo(ptStartX,ptStartY);ctx.lineTo(p.x,p.y);ctx.stroke();}
      else if(ptTool==='arrow'){drawPainterArrow(ctx,ptStartX,ptStartY,p.x,p.y);}
      else if(ptTool==='rect'){ctx.strokeRect(ptStartX,ptStartY,p.x-ptStartX,p.y-ptStartY);ctx.fillRect(ptStartX,ptStartY,p.x-ptStartX,p.y-ptStartY);}
      else if(ptTool==='ellipse'){ctx.beginPath();ctx.ellipse(ptStartX+(p.x-ptStartX)/2,ptStartY+(p.y-ptStartY)/2,Math.abs(p.x-ptStartX)/2,Math.abs(p.y-ptStartY)/2,0,0,Math.PI*2);ctx.stroke();ctx.fill();}
    }
  };
  const endDraw=e=>{
    if(!ptDrawing)return;ptDrawing=false;
    ctx.globalAlpha=1;ctx.globalCompositeOperation='source-over';
    if(ptTool==='fill'){
      const p=getPos(e||{clientX:ptStartX,clientY:ptStartY});
      floodFill(ctx,Math.round(p.x),Math.round(p.y),ptColor);
    }
    ptSaveHistory();
  };
  canvas.addEventListener('mousedown',startDraw);
  canvas.addEventListener('mousemove',draw);
  canvas.addEventListener('mouseup',endDraw);
  canvas.addEventListener('touchstart',startDraw,{passive:false});
  canvas.addEventListener('touchmove',draw,{passive:false});
  canvas.addEventListener('touchend',endDraw,{passive:false});
}

function ptSaveHistory(){
  const canvas=document.getElementById('painter-canvas');
  const ctx=canvas.getContext('2d');
  const data=ctx.getImageData(0,0,canvas.width,canvas.height);
  ptHistory=ptHistory.slice(0,ptHistoryIndex+1);
  ptHistory.push(data);
  if(ptHistory.length>30)ptHistory.shift();
  ptHistoryIndex=ptHistory.length-1;
}

function ptUndo(){
  if(ptHistoryIndex<=0)return;
  ptHistoryIndex--;
  const canvas=document.getElementById('painter-canvas');
  document.getElementById('painter-canvas').getContext('2d').putImageData(ptHistory[ptHistoryIndex],0,0);
}

function ptRedo(){
  if(ptHistoryIndex>=ptHistory.length-1)return;
  ptHistoryIndex++;
  document.getElementById('painter-canvas').getContext('2d').putImageData(ptHistory[ptHistoryIndex],0,0);
}

function ptClear(){
  const canvas=document.getElementById('painter-canvas');
