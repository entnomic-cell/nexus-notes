        </div>
      </div>
      <div class="welcome-stage-notes">
        <div class="welcome-stage-chip">Local-first trust</div>
        <div class="welcome-stage-chip">Linked context</div>
        <div class="welcome-stage-chip">Daily rhythm</div>
        <div class="welcome-stage-chip">Layered workflow</div>
      </div>
    </div>
    <div class="welcome-main">
      <div class="welcome-topbar">
