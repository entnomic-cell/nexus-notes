function eraseByPath(points){
  const block=getPrimarySketchBlock();
  const radius=Math.max(8,ptBrushSize*2.4);
  const next=[];
  block.strokes.forEach(stroke=>{
    if(stroke.tool==='image'){
      const center=getStrokeCenter(stroke);
      const hit=points.some((point,index)=>index>0 && pointToSegmentDistance(center,points[index-1],point)<=radius+Math.max(stroke.frame?.width||0,stroke.frame?.height||0)*0.3);
      if(!hit)next.push(stroke);
      return;
    }
    if(stroke.type==='text' || stroke.tool==='text'){
      const center=getStrokeCenter(stroke);
      const hit=points.some((point,index)=>index>0 && pointToSegmentDistance(center,points[index-1],point)<=radius+Math.max(18,stroke.width*4));
      if(!hit)next.push(stroke);
      return;
    }
    if(stroke.type==='shape'){
      const center=getStrokeCenter(stroke);
      const hit=points.some((point,index)=>index>0 && pointToSegmentDistance(center,points[index-1],point)<=radius+stroke.width);
      if(!hit)next.push(stroke);
      return;
    }
    let segment=[];
    stroke.points.forEach(point=>{
      const hit=points.some((pathPoint,index)=>index>0 && pointToSegmentDistance(point,points[index-1],pathPoint)<=radius);
      if(hit){
        if(segment.length>1)next.push({...stroke,id:sketchUid('stroke'),points:segment.map(normalizeSketchPoint)});
        segment=[];
      }else{
        segment.push(point);
