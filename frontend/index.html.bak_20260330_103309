.docs-side-btn{height:40px;padding:0 14px;border-radius:12px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.04);color:#e7eefc;font-family:var(--font);font-size:13px;font-weight:600;cursor:pointer;text-align:left;}
