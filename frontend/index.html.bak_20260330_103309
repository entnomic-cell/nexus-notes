// Template module: normalize old and new template records so smart templates stay backward compatible.
function normalizeTemplateRecord(template){
  const base=template && typeof template==='object' ? template : {};
  return {
    id:String(base.id||`custom-${Date.now()}`),
    _custom:!!base._custom,
    cat:String(base.cat||'custom'),
    icon:String(base.icon||'document'),
    name:String(base.name||'Untitled Template'),
    desc:String(base.desc||'Custom template'),
    content:String(base.content||''),
    folder:String(base.folder||''),
    tags:Array.isArray(base.tags)?base.tags.map(tag=>String(tag).trim().toLowerCase()).filter(Boolean):[],
    properties:normalizeNoteProperties(base.properties||{}),
    preview:String(base.preview||''),
    recommended:!!base.recommended,
    useCases:Array.isArray(base.useCases)?base.useCases.map(v=>String(v).trim()).filter(Boolean):[],
    starter:String(base.starter||'')
  };
}
function loadStoredTemplates(){
  try{
    return JSON.parse(localStorage.getItem('nx-templates')||'[]').map(t=>normalizeTemplateRecord({...t,_custom:true}));
  }catch(_){
    return [];
  }
}
function persistCustomTemplates(){
  localStorage.setItem('nx-templates',JSON.stringify(customTemplates.map(t=>normalizeTemplateRecord({...t,_custom:true}))));
