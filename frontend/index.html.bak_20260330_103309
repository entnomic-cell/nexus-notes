function wrapSelectionWithStyle(tagName, styles){
  if(!restoreEditorSelection())return false;
  const sel=window.getSelection();
  if(!sel.rangeCount||sel.isCollapsed)return false;
  const range=sel.getRangeAt(0);
  const node=document.createElement(tagName);
  Object.entries(styles).forEach(([key,value])=>{node.style[key]=value;});
  try{
    range.surroundContents(node);
  }catch(e){
    const contents=range.extractContents();
    node.appendChild(contents);
    range.insertNode(node);
  }
  const nextRange=document.createRange();
  nextRange.selectNodeContents(node);
  sel.removeAllRanges();
  sel.addRange(nextRange);
  savedEditorRange=nextRange.cloneRange();
  return true;
}
