  const firstRow=table.rows?.[0];
  if(!firstRow)return;
  const useHeader=!firstRow.querySelector('th');
  firstRow.innerHTML=Array.from(firstRow.cells).map(cell=>useHeader?`<th contenteditable="true">${cell.innerHTML}</th>`:`<td contenteditable="true">${cell.innerHTML}</td>`).join('');
  afterEditorCommand();
}

function getChartDataFromElement(chart){
  const cols=[...chart.querySelectorAll('.inline-chart-col')];
  return {
    labels:cols.map(col=>col.querySelector('.inline-chart-label')?.textContent?.trim()||'').filter(Boolean),
    values:cols.map(col=>parseFloat(col.querySelector('.inline-chart-value')?.textContent||'0')).filter(v=>Number.isFinite(v))
  };
}

function editCurrentChart(){
  const chart=contextMenuState?.chartEl;
  if(!chart)return;
  const data=getChartDataFromElement(chart);
  openQuickSheet({
    title:'Edit Chart',
    subtitle:'Update the labels and values for this chart block.',
    submitLabel:'Update',
    fields:[
      {id:'labels',label:'Labels',value:data.labels.join(', ')},
      {id:'values',label:'Values',value:data.values.join(', ')}
    ],
    onSubmit:async({labels,values})=>{
      const safeLabels=labels.split(',').map(s=>s.trim()).filter(Boolean);
      const safeValues=values.split(',').map(s=>parseFloat(s.trim())).filter(v=>Number.isFinite(v));
      if(!safeLabels.length||!safeValues.length)return;
      chart.outerHTML=buildInlineChartHtml(safeLabels,safeValues);
      afterEditorCommand();
    }
  });
}

function chartToTextBlock(){
