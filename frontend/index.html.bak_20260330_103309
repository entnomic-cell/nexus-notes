function renderCalendar(){
  const months=['January','February','March','April','May','June','July','August','September','October','November','December'];
  document.getElementById('cal-month-title').textContent=`${months[calMonth]} ${calYear}`;
  const source=settings.calendarSource||'updated_at';
  const sourceSelect=document.getElementById('cal-source-select');
  if(sourceSelect && sourceSelect.value!==source)sourceSelect.value=source;
  const days=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  document.getElementById('cal-day-labels').innerHTML=days.map(d=>`<div class="cal-day-label">${d}</div>`).join('');
  getCalendarSelectedDate();
  const first=new Date(calYear,calMonth,1).getDay();
  const daysInMonth=new Date(calYear,calMonth+1,0).getDate();
  const today=new Date();
  const notesByDate={};
  allNotes.forEach(note=>{
    const props=normalizeNoteProperties(note.properties||{});
    const preferredDate=props.due_date || props.daily_date || '';
    const parsed=preferredDate ? parseStoredDate(preferredDate) : parseStoredDate(note[source]);
    if(!parsed || parsed.getFullYear()!==calYear || parsed.getMonth()!==calMonth)return;
    const key=calendarDateKeyFromParts(parsed.getFullYear(),parsed.getMonth(),parsed.getDate());
    if(!notesByDate[key])notesByDate[key]=[];
    notesByDate[key].push(note);
  });
  const eventsByDate={};
  calendarEvents.forEach(eventItem=>{
    if(!eventItem?.date || !eventItem.date.startsWith(`${calYear}-${pad2(calMonth+1)}-`))return;
    if(!eventsByDate[eventItem.date])eventsByDate[eventItem.date]=[];
    eventsByDate[eventItem.date].push(eventItem);
  });
  let html='';
  for(let i=0;i<first;i++)html+=`<div class="cal-day other-month"></div>`;
  for(let day=1;day<=daysInMonth;day++){
    const isToday=today.getFullYear()===calYear&&today.getMonth()===calMonth&&today.getDate()===day;
    const dateKey=calendarDateKeyFromParts(calYear,calMonth,day);
    const dayNotes=(notesByDate[dateKey]||[]).slice(0,2);
    const dayEvents=(eventsByDate[dateKey]||[]).sort(calendarSortEvents);
    const hiddenCount=Math.max(0,(notesByDate[dateKey]?.length||0)-dayNotes.length)+Math.max(0,dayEvents.length-2);
    html+=`<div class="cal-day${isToday?' today':''}${calSelectedDate===dateKey?' selected':''}" onclick="calendarSelectDay('${dateKey}')">
      <div class="cal-day-num">${day}</div>
      ${dayEvents.slice(0,2).map(eventItem=>`<div class="cal-event-chip" onclick="event.stopPropagation();openCalendarEventSheet('${eventItem.id}')"><span class="cal-event-dot" style="background:${esc(eventItem.color||'#5b8def')}"></span>${esc(`${eventItem.start?`${eventItem.start} `:''}${eventItem.title}`.trim().slice(0,28))}</div>`).join('')}
      ${dayNotes.map(note=>`<div class="cal-note-chip" onclick="event.stopPropagation();openNote('${note.id}');switchView('normal')">${esc((note.title||'Untitled').slice(0,20))}</div>`).join('')}
      ${hiddenCount>0?`<div class="cal-overflow-chip">+${hiddenCount} more</div>`:''}
