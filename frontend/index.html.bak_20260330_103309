function findTextInEditor(search){
  const root=document.getElementById('editor-content');
  const query=(search||'').trim().toLowerCase();
  if(!query)return false;
  const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
  while(walker.nextNode()){
    const node=walker.currentNode;
    const text=node.nodeValue||'';
    const idx=text.toLowerCase().indexOf(query);
    if(idx===-1)continue;
    const range=document.createRange();
    range.setStart(node,idx);
    range.setEnd(node,idx+query.length);
    const sel=window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
    node.parentElement?.scrollIntoView({behavior:'smooth',block:'center'});
    return true;
  }
  return false;
}

function replaceTextInEditor(search, replaceWith){
  const root=document.getElementById('editor-content');
  const query=(search||'').trim();
  if(!query)return 0;
  const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
  let replacements=0;
  while(walker.nextNode()){
    const node=walker.currentNode;
    const text=node.nodeValue||'';
    if(!text.toLowerCase().includes(query.toLowerCase()))continue;
    const pattern=new RegExp(query.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),'gi');
    node.nodeValue=text.replace(pattern,replaceWith);
    replacements++;
  }
  return replacements;
}

