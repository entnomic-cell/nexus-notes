/* SMART FILTERS */
function applySmartFilter(type){
  let filtered=allNotes;
  const now=new Date();
  if(type==='recent'){
    const week=7*24*60*60*1000;
    filtered=allNotes.filter(n=>{
      if(!n.updated_at)return false;
      return (now-new Date(n.updated_at+'Z'))<week;
    });
  }else if(type==='bookmarks'){
    filtered=allNotes.filter(n=>bookmarkedNoteIds.has(n.id));
  }else if(type==='long'){
    filtered=allNotes.filter(n=>(n.word_count||0)>=500);
  }
  renderNoteList(filtered);
  showNotif(`${filtered.length} notes found`);
}

