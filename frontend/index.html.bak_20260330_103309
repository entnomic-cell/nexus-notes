<body>

<div id="welcome-screen" onpointerdown="handleWelcomeIntroInteraction()" onkeydown="handleWelcomeIntroInteraction()">
  <div class="welcome-ambient welcome-ambient-a"></div>
  <div class="welcome-ambient welcome-ambient-b"></div>
  <div class="welcome-ambient welcome-ambient-c"></div>
  <div class="welcome-card">
    <div class="welcome-stage">
      <div class="welcome-stage-panel">
        <div>
          <div class="welcome-brand">
            <span>Nexus Workspace</span>
            <span class="welcome-brand-dot"></span>
          </div>
          <div class="welcome-logo-stage">
            <div class="welcome-logo-orbit">
              <img class="welcome-icon" src="/static/icon.ico" alt="Nexus">
            </div>
            <div class="welcome-stage-copy">
              <div class="welcome-kicker">Calm Local Workspace</div>
              <div class="welcome-title">Open Nexus and settle in fast.</div>
              <div class="welcome-copy">A lighter launch screen that feels more like a living workspace: layered, focused, and ready before the rest of the app gets out of your way.</div>
            </div>
          </div>
        </div>
        <div class="welcome-browser-stack">
          <div class="welcome-browser-card top">
            <div class="welcome-browser-bar"><div class="welcome-browser-search"></div></div>
            <div class="welcome-browser-title">Space for capture</div>
            <div class="welcome-browser-copy">Inbox, daily notes, quick capture, and links stay close instead of buried behind setup.</div>
          </div>
          <div class="welcome-browser-card mid">
            <div class="welcome-browser-bar"><div class="welcome-browser-search"></div></div>
            <div class="welcome-browser-title">Space for thinking</div>
            <div class="welcome-browser-copy">Notes, sketches, and structure feel like one surface instead of separate tools.</div>
          </div>
          <div class="welcome-browser-card low">
            <div class="welcome-browser-bar"><div class="welcome-browser-search"></div></div>
            <div class="welcome-browser-title">Space for momentum</div>
