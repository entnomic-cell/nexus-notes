function pointDistance(a,b){
  const dx=a.x-b.x,dy=a.y-b.y;
  return Math.hypot(dx,dy);
}
function pointToSegmentDistance(point,a,b){
  const dx=b.x-a.x,dy=b.y-a.y;
  if(dx===0&&dy===0)return pointDistance(point,a);
  const t=Math.max(0,Math.min(1,((point.x-a.x)*dx+(point.y-a.y)*dy)/(dx*dx+dy*dy)));
  return pointDistance(point,{x:a.x+t*dx,y:a.y+t*dy});
}
function pathLength(points){
  let total=0;
  for(let i=1;i<points.length;i++)total+=pointDistance(points[i-1],points[i]);
  return total;
}
function makeStrokeFromPath(points,tool=ptTool){
