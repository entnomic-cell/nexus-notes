    grid:'radial-gradient(circle at 1px 1px, rgba(126,200,255,0.14) 1px, transparent 0) 0 0/28px 28px, linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0))',
    dots:'radial-gradient(circle, rgba(126,200,255,0.16) 1.2px, transparent 1.4px) 0 0/22px 22px, linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0))',
