function renderStrokePath(ctx,points){
  if(points.length===1){
    const point=points[0];
    ctx.beginPath();
    ctx.arc(point.x,point.y,Math.max(0.8,(ctx.lineWidth||1)*0.5),0,Math.PI*2);
    ctx.fill();
    return;
  }
  if(points.length<2)return;
  ctx.beginPath();
  ctx.moveTo(points[0].x,points[0].y);
  for(let i=1;i<points.length-1;i++){
    const midX=(points[i].x+points[i+1].x)/2;
    const midY=(points[i].y+points[i+1].y)/2;
    ctx.quadraticCurveTo(points[i].x,points[i].y,midX,midY);
  }
  const last=points[points.length-1];
  ctx.lineTo(last.x,last.y);
}
function drawSketchStroke(ctx,stroke,selected=false){
  ctx.save();
  ctx.lineCap='round';
  ctx.lineJoin='round';
  ctx.globalAlpha=stroke.opacity;
  ctx.strokeStyle=selected?'#7ec8ff':stroke.color;
  ctx.fillStyle=selected?'rgba(126,200,255,0.14)':stroke.color;
  if(stroke.type==='text' || stroke.tool==='text'){
    const anchor=stroke.points?.[0]||{x:0,y:0};
    const lines=String(stroke.text||stroke.metadata?.text||'').split(/\r?\n/).filter(Boolean);
    const fontSize=Math.max(14,Number(stroke.metadata?.fontSize)||ptTextSize||30);
    ctx.globalAlpha=Math.min(1,stroke.opacity||0.98);
    ctx.font=`${fontSize}px "Segoe Print","Bradley Hand","Comic Sans MS",cursive`;
    ctx.lineWidth=Math.max(1,Math.round(fontSize/12));
    ctx.textBaseline='top';
    lines.forEach((line,index)=>{
      const y=anchor.y+(index*fontSize*1.22);
      ctx.strokeStyle=selected?'rgba(126,200,255,0.95)':'rgba(7,17,31,0.18)';
      ctx.strokeText(line,anchor.x,y);
      ctx.fillStyle=selected?'#7ec8ff':stroke.color;
      ctx.fillText(line,anchor.x,y);
    });
    ctx.restore();
    return;
  }
  if(stroke.tool==='marker'){ctx.globalAlpha=Math.min(0.28,stroke.opacity);}
  if(stroke.tool==='pencil'){ctx.globalAlpha=Math.min(0.62,stroke.opacity);ctx.setLineDash([1.5,1.5]);}
