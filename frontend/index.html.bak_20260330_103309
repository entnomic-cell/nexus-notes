function convertSelectionToTable(){
  const sel=window.getSelection();
  if(!sel||!sel.rangeCount||sel.isCollapsed){showNotif('Select text first');return;}
  const text=sel.toString().trim();
  const lines=text.split('\n').filter(Boolean);
  if(!lines.length)return;
  const rows=lines.map(line=>line.split(/\t|,|  +/).map(c=>c.trim()));
  const cols=Math.max(...rows.map(r=>r.length));
  const header=`<tr>${Array.from({length:cols},(_,i)=>`<th contenteditable="true">${esc(rows[0]?.[i]||`Col ${i+1}`)}</th>`).join('')}</tr>`;
  const body=rows.slice(1).map(row=>`<tr>${Array.from({length:cols},(_,i)=>`<td contenteditable="true">${esc(row[i]||'')}</td>`).join('')}</tr>`).join('');
  focusEditor();
  document.execCommand('insertHTML',false,`<table>${header}${body}</table><p><br></p>`);
  debounceSave();hideContextMenu();
}
function convertSelectionToChecklist(){
