function inferInboxSignal(note){
  const props=normalizeNoteProperties(note?.properties||{});
  const tags=(note?.tags||[]).map(tag=>String(tag).toLowerCase());
  const title=String(note?.title||'').toLowerCase();
  const content=String(note?.content||'').toLowerCase();
  if(props.type==='meeting' || tags.includes('meeting') || title.includes('meeting'))return {label:'Meeting',folder:'Meetings',type:'meeting'};
  if(props.due_date || content.includes('checkbox') || content.includes('task-list') || /\b(todo|next step|action item)\b/.test(content))return {label:'Action',folder:'Projects',type:'task'};
  if(props.source_url || /https?:\/\//.test(content))return {label:'Reference',folder:'Research',type:'reference'};
  if(tags.includes('idea') || tags.includes('brainstorm') || /\bidea|brainstorm|concept\b/.test(title+' '+content))return {label:'Idea',folder:'Notes',type:'idea'};
  return {label:'Note',folder:'Notes',type:props.type||''};
}
function getInboxRadarStats(notes){
  const now=Date.now();
  return notes.reduce((acc,note)=>{
    const updatedAt=note?.updated_at ? new Date(note.updated_at).getTime() : now;
    if(now-updatedAt < 1000*60*60*24)acc.fresh+=1;
    if(now-updatedAt > 1000*60*60*24*3)acc.stale+=1;
    if((note.title||'Untitled').trim().toLowerCase()==='untitled')acc.untitled+=1;
    if(inferInboxSignal(note).label==='Action')acc.actionable+=1;
    return acc;
  },{fresh:0,stale:0,untitled:0,actionable:0});
}
