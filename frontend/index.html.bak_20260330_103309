function duckEnsureSiteLoaded(force=false){
  const provider=AI_WEBSITE_PROVIDERS[aiMode]||AI_WEBSITE_PROVIDERS.duck;
  const frame=document.getElementById('duck-site-frame');
  if(!frame)return;
  clearTimeout(duckEmbedProbeTimer);
  if(force)blockedEmbedProviders.delete(aiMode);
  duckHideBlocked();
  if(force || frame.dataset.provider!==aiMode || !frame.src || frame.src==='about:blank'){
    frame.src=provider.url;
    frame.dataset.provider=aiMode;
    frame.title=`${provider.label} website`;
    frame.onerror=()=>duckMarkProviderBlocked(provider);
    frame.onload=()=>{
      // Try to detect blank/blocked load (cross-origin, best effort)
      try{
        const doc=frame.contentDocument||frame.contentWindow?.document;
        const href=frame.contentWindow?.location?.href||doc?.location?.href||'';
        if(!href || href==='about:blank' || (doc && doc.body===null)){
          duckMarkProviderBlocked(provider);
          return;
        }
        duckMarkProviderEmbedded();
      }catch(_){
        // Cross-origin access denied = site loaded fine (same-origin would succeed)
        // This is actually GOOD — it means the site loaded but we can't read it
        duckMarkProviderEmbedded();
      }
    };
    duckEmbedProbeTimer=setTimeout(()=>{
      if(frame.dataset.provider!==aiMode)return;
      try{
        const href=frame.contentWindow?.location?.href||frame.contentDocument?.location?.href||'';
        if(!href || href==='about:blank'){
          duckMarkProviderBlocked(provider);
        }
      }catch(_){
        duckMarkProviderEmbedded();
      }
    },4500);
  }
}

async function duckCopyText(text){
  const clean=(text||'').trim();
  if(!clean)return false;
  try{
    if(navigator.clipboard?.writeText){
      await navigator.clipboard.writeText(clean);
      return true;
    }
  }catch(_){}
  const ta=document.createElement('textarea');
  ta.value=clean;
  ta.setAttribute('readonly','readonly');
  ta.style.position='fixed';
  ta.style.opacity='0';
  ta.style.pointerEvents='none';
  document.body.appendChild(ta);
  ta.focus();
  ta.select();
  let copied=false;
  try{copied=document.execCommand('copy');}catch(_){}
  ta.remove();
  return copied;
}

