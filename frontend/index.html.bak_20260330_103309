async function createFolderPrompt(prefill='', onDone=null){
  openQuickSheet({
    title:'New Folder',
    subtitle:'Create a folder without leaving the workspace.',
    submitLabel:'Create',
    fields:[{id:'name',label:'Folder Name',value:prefill,placeholder:'Projects'}],
    onSubmit:async({name})=>{
      if(!name)return;
      const folderName=name.trim();
      try{
        const created=await api('POST','/folders',{name:folderName});
        const resolvedFolder=created?.name||folderName;
        optimisticFolders.add(resolvedFolder.toLowerCase());
        // Keep optimistic UI isolated so a paint bug cannot stop the real
        // follow-up refresh. The authoritative refresh is the important part.
        try{
          addFolderToCache(resolvedFolder);
          revealFolderInSidebar(resolvedFolder);
        }catch(uiErr){
          console.error('Optimistic folder UI failed',uiErr);
        }
        if(onDone)await onDone(resolvedFolder);
        // Refresh folders before any broader note reload work. This keeps the
        // sidebar truthful even if another refresh path regresses.
        try{
          await renderFolders();
          revealFolderInSidebar(resolvedFolder);
        }catch(folderErr){
          console.error('Folder sidebar refresh failed after create',folderErr);
        }
        try{
          await loadAllNotes(currentFolderFilter);
        }catch(notesErr){
          console.error('Note refresh failed after folder create',notesErr);
        }
        revealFolderInSidebar(resolvedFolder);
        showNotif(created?.existing ? `Folder "${resolvedFolder}" is ready` : `Folder "${resolvedFolder}" created`);
      }catch(e){
        console.error('Folder create flow failed after request',e);
        throw e;
      }
    }
  });
  return null;
}

