function ptImportImage(event){
  const file=event.target.files?.[0];
  if(!file)return;
  const reader=new FileReader();
  reader.onload=()=>{
    const img=new Image();
    img.onload=()=>{
      const canvas=document.getElementById('painter-canvas');
      const ctx=canvas.getContext('2d');
      const ratio=Math.min(canvas.width/img.width,canvas.height/img.height,1);
      const w=img.width*ratio,h=img.height*ratio;
      const x=(canvas.width-w)/2,y=(canvas.height-h)/2;
      ctx.drawImage(img,x,y,w,h);
      ptSaveHistory();
      showNotif('Image added to painter');
    };
    img.src=reader.result;
  };
  reader.readAsDataURL(file);
  event.target.value='';
}
function initPainterPointerEngine(){
  const canvas=painterCanvas();
  if(canvas.dataset.engineBound==='true')return;
  canvas.dataset.engineBound='true';
  canvas.addEventListener('pointerdown',event=>{
    if(event.button===2)return;
    event.preventDefault();
    ensurePainterDoc();
    canvas.setPointerCapture?.(event.pointerId);
    ptActivePointers.set(event.pointerId,{x:event.clientX,y:event.clientY});
    wakePainterToolbar();
    if(event.button===1 || event.altKey){
      ptPanState={x:event.clientX,y:event.clientY,originX:ptViewport.x,originY:ptViewport.y};
      return;
    }
    if(ptActivePointers.size===2){
      const [a,b]=[...ptActivePointers.values()];
      ptPinchState={distance:Math.hypot(a.x-b.x,a.y-b.y),zoom:ptViewport.zoom,tapCandidate:true,start:Date.now()};
      return;
    }
    const point=screenToWorld(event.clientX,event.clientY);
    ptCurrentPathPoints=[point];
    if(ptTool==='text'){
      ptCurrentStroke=null;
      ptCurrentPathPoints=[];
      ptAddHandwrittenText(point);
      return;
    }
    if(ptTool==='lasso'){ ptCurrentStroke=null; return; }
    if(ptTool==='eraser'){ ptCurrentStroke=null; return; }
    if(ptTool==='shape'){
      ptCurrentStroke=normalizeSketchStroke({id:sketchUid('stroke'),type:'shape',tool:'shape',shape:ptShapeKind==='auto'?'rect':ptShapeKind,color:ptColor,width:ptBrushSize,opacity:ptOpacity,points:[point,point]});
      schedulePainterRender('shape-start');
      return;
    }
    ptCurrentStroke=makeStrokeFromPath([point],ptTool);
    schedulePainterRender('stroke-start');
  });
  canvas.addEventListener('pointermove',event=>{
    if(!ptActivePointers.has(event.pointerId))return;
    event.preventDefault();
    ptActivePointers.set(event.pointerId,{x:event.clientX,y:event.clientY});
    if(ptPanState){
      ptViewport.x=ptPanState.originX+(event.clientX-ptPanState.x);
      ptViewport.y=ptPanState.originY+(event.clientY-ptPanState.y);
      schedulePainterRender('pan');
      return;
    }
    if(ptPinchState && ptActivePointers.size>=2){
      const [a,b]=[...ptActivePointers.values()];
      const distance=Math.hypot(a.x-b.x,a.y-b.y);
      if(Math.abs(distance-ptPinchState.distance)>18)ptPinchState.tapCandidate=false;
      ptViewport.zoom=Math.max(0.2,Math.min(4.5,ptPinchState.zoom*(distance/Math.max(ptPinchState.distance,1))));
      schedulePainterRender('pinch');
      return;
    }
    const point=screenToWorld(event.clientX,event.clientY);
    ptCurrentPathPoints.push(point);
    if(ptTool==='eraser'){
      eraseByPath(ptCurrentPathPoints.slice(-2));
      commitPainterChange();
      return;
    }
    if(ptTool==='shape' && ptCurrentStroke){
      ptCurrentStroke.points[1]=point;
      schedulePainterRender('shape-preview');
      return;
    }
    if(ptCurrentStroke){
      ptCurrentStroke.points.push(point);
      schedulePainterRender('stroke-preview');
    }
  });
  const finishPointer=event=>{
    if(!ptActivePointers.has(event.pointerId))return;
    event.preventDefault?.();
    canvas.releasePointerCapture?.(event.pointerId);
    ptActivePointers.delete(event.pointerId);
    if(ptPanState){
      ptPanState=null;
      if(!ptActivePointers.size)ptPinchState=null;
      return;
    }
    if(ptActivePointers.size<2 && ptPinchState?.tapCandidate && Date.now()-ptPinchState.start<260){
      ptUndo();
    }
    if(ptActivePointers.size<2)ptPinchState=null;
    const block=getPrimarySketchBlock();
    if(ptTool==='lasso'){
      selectStrokesByPolygon(ptCurrentPathPoints);
      ptCurrentPathPoints=[];
      schedulePainterRender('lasso');
      return;
    }
    if(ptTool==='eraser'){
      ptCurrentPathPoints=[];
      schedulePainterRender('erase-finish');
      return;
    }
    if(!ptCurrentStroke)return;
    let nextStroke=ptCurrentStroke;
    if(['pen','pencil','marker'].includes(ptTool)){
      if(detectScribbleEraseGesture(ptCurrentStroke.points)){
        eraseByPath(ptCurrentStroke.points);
        ptCurrentStroke=null;
        ptCurrentPathPoints=[];
        commitPainterChange();
        return;
      }
      if(detectCircleSelectGesture(ptCurrentStroke.points)){
        selectStrokesByPolygon(ptCurrentStroke.points);
        ptCurrentStroke=null;
        ptCurrentPathPoints=[];
        schedulePainterRender('circle-select');
        return;
      }
      const assisted=detectShapeAssist(ptCurrentStroke.points);
      if(assisted)nextStroke=assisted;
    }
    block.strokes.push(nextStroke);
    ensurePainterStrokeVisible(nextStroke);
    ptCurrentStroke=null;
    ptCurrentPathPoints=[];
    commitPainterChange(nextStroke);
  };
  canvas.addEventListener('pointerup',finishPointer);
  canvas.addEventListener('pointercancel',finishPointer);
  canvas.addEventListener('lostpointercapture',()=>resetPainterInteractionState({clearPath:false,clearStroke:false}));
  canvas.addEventListener('wheel',event=>{
    event.preventDefault();
    const factor=event.deltaY<0?1.08:0.92;
    ptViewport.zoom=Math.max(0.2,Math.min(4.5,ptViewport.zoom*factor));
    schedulePainterRender('wheel');
  },{passive:false});
  window.addEventListener('blur',()=>resetPainterInteractionState());
}
function initPainterToolbar(){
  const grab=document.getElementById('pt-smart-grab');
  if(grab.dataset.bound==='true')return;
  grab.dataset.bound='true';
