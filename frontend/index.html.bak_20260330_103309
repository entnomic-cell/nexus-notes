    if(focusTimerRuntime.status!=='running'){
      stopFocusAmbientLoop();
      return;
    }
    const freq=tones[focusTimerRuntime.mode]||220;
    const volume=focusTimerRuntime.mode==='soft'?0.006:focusTimerRuntime.mode==='storm'?0.01:0.008;
    const duration=focusTimerRuntime.mode==='soft'?0.12:0.18;
