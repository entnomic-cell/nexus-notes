function setEditorContent(content){
  const el=document.getElementById('editor-content');
  if(content&&/<[a-z][\s\S]*>/i.test(content)){el.innerHTML=content;}
  else{el.innerHTML=(content||'').split('\n').map(line=>line?`<p>${esc(line)}</p>`:'<p><br></p>').join('');}
  normalizeEditorMarkdown();
  hydrateSketchBlocks(el);
}

function normalizeInlineMarkdown(html){
  let out=html;
  out=out.replace(/`([^`]+)`/g,'<code>$1</code>');
  out=out.replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>');
  out=out.replace(/__([^_]+)__/g,'<strong>$1</strong>');
  out=out.replace(/(^|[\s>])\*([^*\n<][^*\n<]*?)\*(?=$|[\s<])/g,'$1<em>$2</em>');
  out=out.replace(/(^|[\s>])_([^_\n<][^_\n<]*?)_(?=$|[\s<])/g,'$1<em>$2</em>');
  out=out.replace(/~~([^~]+)~~/g,'<s>$1</s>');
  return out;
}

function normalizeEditorMarkdown(){
  const root=document.getElementById('editor-content');
  if(!root)return;
  if(!root.querySelector('p,div,li,blockquote,h1,h2,h3,pre,table,img,.note-sketch-block') && (root.textContent||'').trim()){
    root.innerHTML=`<p>${esc(root.textContent)}</p>`;
  }
  const blocks=[...root.querySelectorAll('p,div,li,blockquote')];
  blocks.forEach(block=>{
    if(block.classList.contains('note-sketch-block')||block.closest('.note-sketch-block'))return;
    if(block.querySelector('pre,table,img,.note-sketch-block'))return;
    const text=block.textContent||'';
    const trimmed=text.trim();
    if(!trimmed)return;
    if(/^###\s+/.test(trimmed)){block.outerHTML=`<h3>${esc(trimmed.replace(/^###\s+/,''))}</h3>`;return;}
    if(/^##\s+/.test(trimmed)){block.outerHTML=`<h2>${esc(trimmed.replace(/^##\s+/,''))}</h2>`;return;}
    if(/^#\s+/.test(trimmed)){block.outerHTML=`<h1>${esc(trimmed.replace(/^#\s+/,''))}</h1>`;return;}
    const next=normalizeInlineMarkdown(block.innerHTML);
    if(next!==block.innerHTML)block.innerHTML=next;
  });
}

function getEditorContent(){
  normalizeEditorMarkdown();
  hydrateSketchBlocks();
  return document.getElementById('editor-content').innerHTML||'';
}

