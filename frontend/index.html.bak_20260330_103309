/* CALENDAR VIEW */
function pad2(n){return String(n).padStart(2,'0');}
function calendarDateKeyFromParts(year,month,day){return `${year}-${pad2(month+1)}-${pad2(day)}`;}
function parseStoredDate(value){
  const raw=String(value||'').trim();
  if(!raw)return null;
  const withZone=(/z$/i.test(raw) || /[+-]\d{2}:\d{2}$/.test(raw)) ? raw : `${raw}Z`;
  const parsed=new Date(withZone);
  if(!Number.isNaN(parsed.getTime()))return parsed;
  const fallback=new Date(raw);
  return Number.isNaN(fallback.getTime())?null:fallback;
}
function calendarReadableDate(dateKey){
  const date=new Date(`${dateKey}T00:00:00`);
  if(Number.isNaN(date.getTime()))return dateKey;
  return date.toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric',year:'numeric'});
}
function calendarSortEvents(a,b){
  return `${a.date||''} ${a.start||'99:99'}`.localeCompare(`${b.date||''} ${b.start||'99:99'}`) || (a.title||'').localeCompare(b.title||'');
}
function getCalendarSelectedDate(){
  const visibleMonth=`${calYear}-${pad2(calMonth+1)}-`;
  if(calSelectedDate?.startsWith(visibleMonth))return calSelectedDate;
  const now=new Date();
  if(now.getFullYear()===calYear && now.getMonth()===calMonth){
    calSelectedDate=calendarDateKeyFromParts(calYear,calMonth,now.getDate());
  }else{
    calSelectedDate=calendarDateKeyFromParts(calYear,calMonth,1);
  }
  return calSelectedDate;
}
function getCalendarNotesForDate(dateKey){
  const source=settings.calendarSource||'updated_at';
  return allNotes.filter(note=>{
    const props=normalizeNoteProperties(note.properties||{});
    const preferredDate=props.due_date || props.daily_date || '';
    const parsed=preferredDate ? parseStoredDate(preferredDate) : parseStoredDate(note[source]);
    if(!parsed)return false;
    return calendarDateKeyFromParts(parsed.getFullYear(),parsed.getMonth(),parsed.getDate())===dateKey;
  }).sort((a,b)=>(b.updated_at||'').localeCompare(a.updated_at||''));
}
function getCalendarEventsForDate(dateKey){
  return calendarEvents.filter(eventItem=>eventItem?.date===dateKey).sort(calendarSortEvents);
}
async function saveCalendarEvents(){
  // Calendar workflow module: persist note links with events so calendar-note relationships survive reloads and backups.
  calendarEvents=calendarEvents
    .filter(eventItem=>eventItem && eventItem.id && eventItem.title && eventItem.date)
    .map(eventItem=>({
      ...eventItem,
      title:String(eventItem.title||'').trim(),
      date:String(eventItem.date||'').trim(),
      start:String(eventItem.start||'').trim(),
      end:String(eventItem.end||'').trim(),
      location:String(eventItem.location||'').trim(),
      color:String(eventItem.color||'#5b8def').trim() || '#5b8def',
      note_id:String(eventItem.note_id||'').trim(),
      description:String(eventItem.description||'').trim()
    }))
    .sort(calendarSortEvents);
  await api('PUT','/settings',{calendarEvents:JSON.stringify(calendarEvents)}).catch(()=>{});
}
function formatCalendarEventTime(eventItem){
  const start=(eventItem.start||'').trim();
  const end=(eventItem.end||'').trim();
  if(start && end)return `${start} - ${end}`;
  if(start)return start;
  if(end)return `Until ${end}`;
  return 'All day';
}
function renderCalendarDetail(){
  const panel=document.getElementById('cal-detail-panel');
  if(!panel)return;
  const dateKey=getCalendarSelectedDate();
  const dayEvents=getCalendarEventsForDate(dateKey);
  const dayNotes=getCalendarNotesForDate(dateKey);
  panel.innerHTML=`
