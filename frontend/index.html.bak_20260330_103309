        <div class="welcome-nav">
          <button class="welcome-btn" onclick="prevWelcomeSlide()">Previous</button>
          <button class="welcome-btn" onclick="nextWelcomeSlide()">Next</button>
        </div>
      </div>
      <div class="welcome-slide-shell">
        <div class="welcome-slide-track" id="welcome-slide-track">
          <section class="welcome-slide">
            <div class="welcome-slide-label">Overview</div>
            <div class="welcome-slide-title">Everything important is already inside the app shell.</div>
            <div class="welcome-slide-copy">Write notes, organize folders, ask AI sites about the current context, save painter sketches as notes, run focus sessions, and keep your music in one workspace.</div>
