  if(!await confirmSheet({title:'Delete Note',subtitle:`Delete "${currentNote.title}"? This removes it from the workspace.`,confirmLabel:'Delete'}))return;
  await api('DELETE',`/notes/${currentNote.id}`);
  removeTab(currentNote.id);currentNote=null;
  document.getElementById('editor-empty').style.display='flex';
  document.getElementById('editor-body').style.display='none';
  document.getElementById('panel-properties').style.display='none';
  document.getElementById('panel-tasks').style.display='none';
