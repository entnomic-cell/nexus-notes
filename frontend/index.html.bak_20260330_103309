function switchView(v){
  currentView=v;
  const views=['normal','table','kanban','calendar','gallery','inbox'];
  views.forEach(name=>{
    const el=document.getElementById(name+'-view');
    if(el){el.classList.toggle('active',name===v);}
    const btn=document.getElementById('vbtn-'+name);
    if(btn)btn.classList.toggle('active',name===v);
  });
  // hide/show the editor inner (scroll + format toolbar), NOT the whole editor-area
  // The alt views (table/kanban/etc) live inside editor-area so we must keep it visible
  const editorScroll=document.getElementById('editor-scroll');
  if(editorScroll) editorScroll.style.display=(v==='normal')?'':'none';
  const fmtBar=document.getElementById('fmt-toolbar');
  if(fmtBar && v!=='normal') fmtBar.style.display='none';
  if(fmtBar && v==='normal' && settings.toolbar) fmtBar.classList.add('visible');
  // show save-template btn only in normal
  const stb=document.getElementById('save-tmpl-btn');
  if(stb)stb.style.display=(v==='normal'&&currentNote)?'flex':'none';
  if(v==='table')renderTableView();
  if(v==='kanban')renderKanban();
  if(v==='calendar')renderCalendar();
  if(v==='gallery')renderGallery();
  if(v==='inbox')renderInboxPage(allNotes);
}

/* TABLE VIEW */
function renderTableView(){
  let notes=[...allNotes];
  const q=(document.getElementById('table-filter')?.value||'').toLowerCase();
  if(q)notes=notes.filter(n=>n.title.toLowerCase().includes(q)||(n.folder||'').toLowerCase().includes(q)||(n.tags||[]).join(' ').toLowerCase().includes(q));
  notes.sort((a,b)=>{
    let av=a[tableSortCol]||'',bv=b[tableSortCol]||'';
    if(tableSortCol==='word_count'){av=Number(av)||0;bv=Number(bv)||0;}
    return tableSortDir*(av>bv?1:av<bv?-1:0);
  });
  document.getElementById('table-count').textContent=`${notes.length} notes`;
  document.getElementById('table-body').innerHTML=notes.map(n=>`
    <tr onclick="openNote('${n.id}');switchView('normal')">
      <td style="font-weight:500">${esc(n.title||'Untitled')}</td>
      <td>${esc(n.folder||'Notes')}</td>
      <td>${(n.tags||[]).map(t=>`<span class="table-tag">${esc(t)}</span>`).join('')}</td>
      <td>${n.word_count||0}</td>
      <td>${relTime(n.updated_at)}</td>
    </tr>`).join('');
}
function filterTable(q){renderTableView();}
function sortTable(col){
