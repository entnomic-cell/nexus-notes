function getWelcomeNoiseBuffer(ctx){
  if(welcomeIntroNoiseBuffer)return welcomeIntroNoiseBuffer;
  const buffer=ctx.createBuffer(1,ctx.sampleRate*1.2,ctx.sampleRate);
  const data=buffer.getChannelData(0);
  for(let i=0;i<data.length;i++){
    data[i]=(Math.random()*2-1)*(1-(i/data.length)*0.18);
  }
  welcomeIntroNoiseBuffer=buffer;
  return buffer;
