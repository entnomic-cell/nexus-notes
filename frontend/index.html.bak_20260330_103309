async function importMarkdownFiles(e){
  const files=Array.from(e.target.files||[]);
  if(!files.length)return;
  let count=0;
  for(const file of files){
    const text=await file.text();
    let title=file.name.replace(/\.md$/,'').replace(/_/g,' ');
    let content=text;
    // parse frontmatter
    const fm=text.match(/^---\n([\s\S]*?)\n---\n/);
    if(fm){
      const titleMatch=fm[1].match(/title:\s*(.+)/);
      if(titleMatch)title=titleMatch[1].trim();
      content=text.slice(fm[0].length);
    }
    const htmlContent=markdownToHtml(content);
    await api('POST','/notes',{title,content:htmlContent,folder:'Imported',tags:['imported']});
    count++;
  }
  e.target.value='';
  await loadAllNotes();
  showNotif(`Imported ${count} file${count>1?'s':''} ✓`);
  closeExportModal();
}
async function importBackupJson(e){
  const file=e.target.files?.[0];
  if(!file)return;
  try{
    const raw=JSON.parse(await file.text());
    const notes=Array.isArray(raw)?raw:(Array.isArray(raw.notes)?raw.notes:[]);
    if(!notes.length){showNotif('No notes found in backup');return;}
    let count=0;
    for(const item of notes){
      const title=String(item.title||item.name||'Untitled').trim()||'Untitled';
      const tags=Array.isArray(item.tags)?item.tags.map(String):String(item.tags||'').split(',').map(t=>t.trim()).filter(Boolean);
      let content=typeof item.content==='string'?item.content:'';
      if(!content&&typeof item.body==='string')content=markdownToHtml(item.body);
      if(content && !/<[a-z][\s\S]*>/i.test(content))content=plainTextToHtml(content);
      await api('POST','/notes',{
        title,
        content,
        folder:String(item.folder||'Imported').trim()||'Imported',
        tags
      });
      count++;
    }
    await loadAllNotes();
    closeExportModal();
    showNotif(`Imported ${count} notes`);
  }catch(err){
    showNotif('Backup import failed');
  }finally{
    e.target.value='';
  }
}

