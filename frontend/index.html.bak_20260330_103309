    ptHistory=ptHistory.slice(0,ptHistoryIndex+1);
    ptHistory.push(cloneSketch(ptDoc));
    ptHistoryIndex=ptHistory.length-1;
  }
  wakePainterToolbar();
  if(changedStroke)ensurePainterStrokeVisible(changedStroke);
  schedulePainterRender('commit');
