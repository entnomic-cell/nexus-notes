  });
}

function clamp(n,min,max){return Math.max(min,Math.min(max,n));}
function normalizeStatusbarHeight(value){return clamp(parseInt(value,10)||24,18,72);}

function initResizableUI(){
  const bind=(handleId,move,persist,cursor='col-resize')=>{
    const handle=document.getElementById(handleId);
    if(!handle)return;
    let active=false;
    const onMove=e=>{
      if(!active)return;
      move(e);
    };
    const stop=()=>{
      if(!active)return;
      active=false;
      handle.classList.remove('active');
      document.body.style.userSelect='';
      document.body.style.cursor='';
      window.removeEventListener('mousemove',onMove);
      window.removeEventListener('mouseup',stop);
      if(persist)persist();
    };
    handle.addEventListener('mousedown',e=>{
      e.preventDefault();
      active=true;
      handle.classList.add('active');
      document.body.style.userSelect='none';
      document.body.style.cursor=cursor;
      window.addEventListener('mousemove',onMove);
      window.addEventListener('mouseup',stop);
    });
  };

  bind('sidebar-resizer',e=>{
    const width=clamp(e.clientX,180,420);
    document.documentElement.style.setProperty('--sidebar-w',`${width}px`);
  },()=>api('PUT','/settings',{sidebarWidth:parseInt(getComputedStyle(document.documentElement).getPropertyValue('--sidebar-w'),10)}).catch(()=>{}));

  bind('right-panel-resizer',e=>{
    const width=clamp(window.innerWidth-e.clientX,220,520);
    document.documentElement.style.setProperty('--right-panel-w',`${width}px`);
  },()=>api('PUT','/settings',{rightPanelWidth:parseInt(getComputedStyle(document.documentElement).getPropertyValue('--right-panel-w'),10)}).catch(()=>{}));

  bind('duck-sidebar-resizer',e=>{
    const width=clamp(window.innerWidth-e.clientX,340,860);
    document.documentElement.style.setProperty('--duck-sidebar-w',`${width}px`);
  },()=>api('PUT','/settings',{duckSidebarWidth:parseInt(getComputedStyle(document.documentElement).getPropertyValue('--duck-sidebar-w'),10)}).catch(()=>{}));

  bind('statusbar-resizer',e=>{
    const area=document.getElementById('editor-area');
    if(!area)return;
    const bounds=area.getBoundingClientRect();
    const height=normalizeStatusbarHeight(bounds.bottom-e.clientY);
    document.documentElement.style.setProperty('--statusbar-h',`${height}px`);
  },()=>{
    const actualHeight=normalizeStatusbarHeight(document.getElementById('statusbar')?.offsetHeight||24);
    document.documentElement.style.setProperty('--statusbar-h',`${actualHeight}px`);
    api('PUT','/settings',{statusbarHeight:actualHeight}).catch(()=>{});
  },'row-resize');
}

