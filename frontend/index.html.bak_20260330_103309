<!-- ════ GOOGLE SEARCH PANEL ════ -->
<div id="search-panel">
  <div id="search-panel-header">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;color:var(--accent);flex-shrink:0"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    <span style="font-size:14px;font-weight:600;color:var(--text)">Web Search</span>
    <div id="search-panel-bar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;color:var(--text3);flex-shrink:0;margin-right:6px"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input type="text" id="search-panel-input" placeholder="Search Google…" onkeydown="searchPanelKeydown(event)">
      <button id="search-panel-btn" onclick="doWebSearch()">Search</button>
    </div>
    <div style="display:flex;gap:6px;margin-left:8px;flex-shrink:0;">
      <button class="chip" onclick="doWebSearch('https://www.google.com')" title="Google Home" style="padding:4px 10px;font-size:11px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:11px;height:11px"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        Home
      </button>
      <button class="chip" onclick="doWebSearch('https://www.google.com/maps')" title="Google Maps" style="padding:4px 10px;font-size:11px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:11px;height:11px"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Maps
      </button>
    </div>
    <button class="icon-btn" onclick="closeSearchPanel()" style="margin-left:4px;" title="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <iframe id="search-panel-frame" src="about:blank" referrerpolicy="strict-origin-when-cross-origin"></iframe>
  <div id="search-panel-placeholder">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    <p>Type a query, or open Google Home or Maps inside the panel.</p>
  </div>
</div>

<!-- ════ GRAPH VIEW ════ -->
<div id="graph-view">
  <div id="graph-header">
    <div style="font-size:15px;font-weight:600">Knowledge Graph</div>
    <button class="icon-btn" onclick="closeGraph()">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <canvas id="graph-canvas"></canvas>
</div>



<!-- ════ MINDMAP VIEW ════ -->
<div id="mindmap-view">
  <div id="mindmap-header">
    <button class="icon-btn" onclick="closeMindmap()">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <input type="text" id="mm-title-input" value="Untitled Map" style="background:transparent;border:none;outline:none;font-family:var(--font);font-size:15px;font-weight:600;color:var(--text);flex:1;">
    <div class="mm-toolbar">
      <div class="mm-toolbar-group">
        <button class="mm-btn" onclick="mmAddNode()">+ Node</button>
        <button class="mm-btn" onclick="mmAddChild()">+ Child</button>
        <button class="mm-btn" onclick="mmDeleteSelected()">Delete</button>
        <button class="mm-btn" onclick="mmConnectMode()" id="mm-connect-btn">Connect</button>
      </div>
      <div class="mm-toolbar-group">
        <span class="mm-toolbar-label">Layout</span>
        <select id="mm-layout-mode" class="tb-select mm-select" onchange="mmUpdateMeta('layoutMode',this.value)">
          <option value="manual">Manual</option>
          <option value="tree">Tree</option>
        </select>
        <button class="mm-btn" onclick="mmAutoArrange()" id="mm-layout-btn">Auto Layout</button>
        <button class="mm-btn" onclick="mmToggleFocus()" id="mm-focus-btn">Focus</button>
        <button class="mm-btn" onclick="mmClearFocus()">Clear</button>
      </div>
      <div class="mm-toolbar-group">
        <span class="mm-toolbar-label">Style</span>
        <select id="mm-node-shape" class="tb-select" style="height:28px;" onchange="mmApplySelectedStyle('shape',this.value)">
          <option value="ellipse">Ellipse</option>
          <option value="rect">Rectangle</option>
          <option value="diamond">Diamond</option>
        </select>
        <select id="mm-node-style" class="tb-select mm-select" onchange="mmApplySelectedStyle('labelStyle',this.value)">
          <option value="normal">Normal</option>
          <option value="emphasis">Emphasis</option>
          <option value="soft">Soft</option>
        </select>
        <select id="mm-node-size" class="tb-select mm-select" onchange="mmUpdateMeta('nodeSize',this.value)">
          <option value="sm">Small</option>
          <option value="md">Medium</option>
          <option value="lg">Large</option>
        </select>
        <select id="mm-font-size" class="tb-select mm-select" onchange="mmUpdateMeta('fontSize',this.value)">
          <option value="12">Text S</option>
          <option value="14">Text M</option>
          <option value="16">Text L</option>
        </select>
        <button class="tb-color-swatch" id="mm-node-color-btn" data-color="#c8a96e" onclick="openColorPopover('mindmap',event)" title="Node Color" style="width:28px;height:28px;">
          <div class="tb-color-bar" id="mm-node-color-bar" style="background:#c8a96e"></div>
        </button>
      </div>
      <div class="mm-toolbar-group">
        <span class="mm-toolbar-label">View</span>
        <select id="mm-edge-style" class="tb-select mm-select" onchange="mmUpdateMeta('edgeStyle',this.value)">
          <option value="dashed">Dashed</option>
          <option value="solid">Solid</option>
          <option value="curved">Curved</option>
        </select>
        <select id="mm-background-style" class="tb-select mm-select" onchange="mmUpdateMeta('background',this.value)">
          <option value="grid">Grid</option>
          <option value="dots">Dots</option>
          <option value="plain">Plain</option>
        </select>
        <button class="mm-btn" onclick="mmToggleSelectedCollapse()" id="mm-collapse-btn">Collapse</button>
        <button class="mm-btn" onclick="mmUndo()" id="mm-undo-btn">Undo</button>
        <button class="mm-btn" onclick="mmRedo()" id="mm-redo-btn">Redo</button>
        <button class="mm-btn primary" onclick="saveMindmap()">Save</button>
      </div>
    </div>
  </div>
  <div id="mm-body">
    <div id="mm-minilist">
      <div style="padding:10px 14px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--text3);">My Maps</div>
      <div id="mm-list"></div>
      <div style="padding:6px 10px;">
        <button onclick="newMindmap()" style="width:100%;padding:7px;border-radius:var(--r);border:1px dashed var(--border2);background:transparent;color:var(--text3);cursor:pointer;font-family:var(--font);font-size:12px;">+ New Map</button>
      </div>
    </div>
    <div id="mm-content">
      <div id="mindmap-canvas">
        <svg id="mindmap-svg" xmlns="http://www.w3.org/2000/svg"></svg>
        <div id="mindmap-nodes"></div>
      </div>
    </div>
  </div>
</div>

<!-- ════ PAINTER ════ -->
<div id="painter-view">
  <div id="painter-header">
    <div id="painter-header-main">
      <button class="icon-btn" onclick="closePainter()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
      <input type="text" id="painter-title" value="Untitled Drawing" style="background:transparent;border:none;outline:none;font-family:var(--font);font-size:14px;font-weight:600;color:var(--text);width:240px;">
      <button class="pt-header-chip" onclick="ptAddHandwrittenText()" title="Add handwritten text">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
        Handwritten Text
      </button>
    </div>
    <div id="painter-header-actions">
      <button class="pt-header-chip" onclick="ptUndo()">Undo</button>
      <button class="pt-header-chip" onclick="ptRedo()">Redo</button>
      <button class="pt-header-chip" id="pt-debug-toggle" onclick="togglePainterDebugMode()">Debug</button>
      <button class="pt-header-chip" onclick="ptSave()" style="color:var(--teal)">Save Library</button>
      <button class="pt-header-chip" onclick="ptSaveAsNote()" style="color:var(--blue)">Save As Note</button>
      <button class="pt-header-chip" onclick="ptExport()" style="color:var(--accent)">Export PNG</button>
    </div>
    <div id="painter-toolbar">
      <button class="pt-btn active" onclick="setPtTool('pen')" id="pt-pen" title="Pen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
      </button>
      <button class="pt-btn" onclick="setPtTool('brush')" id="pt-brush" title="Brush">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9.06 11.9l8.07-8.06a2.85 2.85 0 1 1 4.03 4.03l-8.06 8.08"/><path d="M7.07 14.94C5.79 16.2 4 16 4 16s-.2-1.79 1.06-3.07l4.94-4.94 4 4-6.93 6.95z"/></svg>
      </button>
      <button class="pt-btn" onclick="setPtTool('eraser')" id="pt-eraser" title="Eraser">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 20H7L3 16l13.79-13.79a2 2 0 0 1 2.83 0L21 4a2 2 0 0 1 0 2.83L9.17 18H20v2z"/></svg>
      </button>
      <div class="pt-sep"></div>
      <button class="pt-btn" onclick="setPtTool('line')" id="pt-line" title="Line">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </button>
      <button class="pt-btn" onclick="setPtTool('rect')" id="pt-rect" title="Rectangle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
      </button>
      <button class="pt-btn" onclick="setPtTool('ellipse')" id="pt-ellipse" title="Ellipse">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="12" rx="10" ry="6"/></svg>
      </button>
      <button class="pt-btn" onclick="setPtTool('arrow')" id="pt-arrow" title="Arrow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 19 19 5"/><path d="m11 5 8 0 0 8"/></svg>
      </button>
      <button class="pt-btn" onclick="setPtTool('text')" id="pt-text" title="Text">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
      </button>
      <button class="pt-btn" onclick="setPtTool('fill')" id="pt-fill" title="Fill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16.56 8.94L7.62 0 6.21 1.41l2.38 2.38-5.15 5.15a1.49 1.49 0 0 0 0 2.12l5.5 5.5c.29.29.68.44 1.06.44s.77-.15 1.06-.44l5.5-5.5c.59-.58.59-1.53 0-2.12zM5.21 10L10 5.21 14.79 10H5.21z"/><path d="M19 11.5s-2 2.17-2 3.5c0 1.1.9 2 2 2s2-.9 2-2c0-1.33-2-3.5-2-3.5z"/></svg>
      </button>
      <div class="pt-sep"></div>
      <div class="pt-color-row" id="pt-colors"></div>
      <button class="tb-color-swatch" id="pt-custom-color-btn" data-color="#c8a96e" onclick="openColorPopover('painter',event)" title="Custom Color" style="width:24px;height:24px;">
        <div class="tb-color-bar" id="pt-custom-color-bar" style="background:#c8a96e"></div>
      </button>
      <div class="pt-sep"></div>
      <span style="font-size:11px;color:var(--text3);">Size</span>
      <input type="range" class="pt-size" min="1" max="40" value="4" id="pt-size" oninput="ptBrushSize=parseInt(this.value)">
      <span style="font-size:11px;color:var(--text3);">Opacity</span>
      <input type="range" class="pt-size" min="0.1" max="1" step="0.05" value="1" id="pt-opacity" oninput="ptOpacity=parseFloat(this.value)">
      <span style="font-size:11px;color:var(--text3);">Text</span>
      <input type="range" class="pt-size" min="14" max="72" step="2" value="30" id="pt-text-size" oninput="ptTextSize=parseInt(this.value)">
      <div class="pt-sep"></div>
      <button class="pt-btn" onclick="document.getElementById('pt-import-file').click()" title="Import Image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M17 8l-5-5-5 5"/><path d="M12 3v12"/></svg></button>
      <button class="pt-btn" onclick="ptClear()" title="Clear"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
      <button class="pt-btn" onclick="ptUndo()" title="Undo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 14L4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg></button>
      <button class="pt-btn" onclick="ptRedo()" title="Redo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 14 5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13"/></svg></button>
      <button class="pt-btn" onclick="ptSave()" title="Save" style="color:var(--teal);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg></button>
      <button class="pt-btn" onclick="ptSaveAsNote()" title="Save As Note" style="color:var(--blue);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M12 18v-6"/><path d="M9 15h6"/></svg></button>
      <button class="pt-btn" onclick="ptExport()" title="Export PNG" style="color:var(--accent);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></button>
      <input type="file" id="pt-import-file" accept="image/*" hidden onchange="ptImportImage(event)">
    </div>
  </div>
  <div id="painter-canvas-wrap">
    <canvas id="painter-canvas" width="1600" height="900"></canvas>
    <div id="pt-smart-toolbar">
      <div class="pt-smart-grab" id="pt-smart-grab" title="Drag toolbar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="6" r="1"/><circle cx="15" cy="6" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="9" cy="18" r="1"/><circle cx="15" cy="18" r="1"/></svg>
      </div>
      <div class="pt-smart-tools">
        <button class="pt-smart-btn active" onclick="setPtTool('pen')" id="pt-smart-pen" title="Pen"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg></button>
        <button class="pt-smart-btn" onclick="setPtTool('pencil')" id="pt-smart-pencil" title="Pencil"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 21 3.5-.8L19 7.7 16.3 5 3.8 17.5z"/><path d="m14 4 3 3"/></svg></button>
        <button class="pt-smart-btn" onclick="setPtTool('marker')" id="pt-smart-marker" title="Marker"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 17h6l11-11-6-6L3 11v6z"/><path d="M14 3l7 7"/></svg></button>
        <button class="pt-smart-btn" onclick="setPtTool('eraser')" id="pt-smart-eraser" title="Eraser"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 20H7L3 16l13.79-13.79a2 2 0 0 1 2.83 0L21 4a2 2 0 0 1 0 2.83L9.17 18H20v2z"/></svg></button>
        <button class="pt-smart-btn" onclick="setPtTool('lasso')" id="pt-smart-lasso" title="Lasso"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 4c-2.5 1-4 3-4 6 0 4 3.5 7 9 7 4 0 7-1.5 8-4 1-2.5-.5-5-3-5-2 0-3.5 1.5-3.5 3 0 1.8 1.2 3 3.2 3H19"/></svg></button>
        <button class="pt-smart-btn" onclick="setPtTool('shape')" id="pt-smart-shape" title="Shape"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 15 15 8"/></svg></button>
        <button class="pt-smart-btn" onclick="setPtTool('text')" id="pt-smart-text" title="Handwritten Text"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg></button>
      </div>
      <select class="pt-smart-select" id="pt-shape-select" onchange="ptShapeKind=this.value">
        <option value="auto">Auto</option>
        <option value="line">Line</option>
        <option value="rect">Rectangle</option>
        <option value="ellipse">Circle</option>
        <option value="arrow">Arrow</option>
      </select>
      <button class="pt-smart-swatch" onclick="openColorPopover('painter',event)" id="pt-smart-color-btn" title="Color">
        <div class="pt-smart-swatch-bar" id="pt-smart-color-bar" style="background:#c8a96e"></div>
      </button>
      <input type="range" class="pt-size pt-smart-size" min="1" max="24" value="4" id="pt-smart-size" oninput="ptBrushSize=parseInt(this.value,10)||4">
      <button class="pt-smart-btn" onclick="ptUndo()" title="Undo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg></button>
      <button class="pt-smart-btn" onclick="ptRedo()" title="Redo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 14 5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13"/></svg></button>
    </div>
    <div class="pt-canvas-hint" id="pt-canvas-hint">Pen to draw, pinch to zoom, two-finger tap to undo.</div>
  </div>
</div>

<!-- ════ COMMAND PALETTE ════ -->
<div id="cmd">
  <div id="cmd-backdrop" onclick="closeCmdPalette()"></div>
  <div id="cmd-box">
    <div id="cmd-input-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input type="text" id="cmd-input" placeholder="Search notes, commands…" oninput="updateCmd(this.value)" onkeydown="cmdKeydown(event)">
    </div>
    <div id="cmd-results"></div>
    <div id="cmd-footer">
      <span><kbd>↑↓</kbd> navigate</span>
      <span><kbd>⏎</kbd> open</span>
      <span><kbd>Esc</kbd> close</span>
    </div>
  </div>
</div>

<!-- ════ SETTINGS MODAL ════ -->
<div id="settings-modal">
  <div id="settings-backdrop" onclick="closeSettings()"></div>
  <div id="settings-box">
    <div class="settings-header">
      <span style="font-size:15px;font-weight:600">Settings & Customization</span>
      <button class="icon-btn" onclick="closeSettings()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="settings-body">
      <div class="settings-section">
        <div class="settings-section-title">Appearance</div>
        <div class="theme-grid">
          <div class="theme-card active" onclick="setTheme('')" data-theme="">
            <div class="theme-swatch" style="background:linear-gradient(135deg,#0b1220,#20314a)"></div>
            Nexus
          </div>
          <div class="theme-card" onclick="setTheme('black')" data-theme="black">
            <div class="theme-swatch" style="background:linear-gradient(135deg,#000000,#181818)"></div>
            Black
          </div>
          <div class="theme-card" onclick="setTheme('nord')" data-theme="nord">
            <div class="theme-swatch" style="background:linear-gradient(135deg,#2e3440,#4c566a)"></div>
            Nord
          </div>
          <div class="theme-card" onclick="setTheme('mocha')" data-theme="mocha">
            <div class="theme-swatch" style="background:linear-gradient(135deg,#1e1e2e,#45475a)"></div>
            Mocha
          </div>
          <div class="theme-card" onclick="setTheme('solarized')" data-theme="solarized">
            <div class="theme-swatch" style="background:linear-gradient(135deg,#002b36,#0d5a66)"></div>
            Solar
          </div>
          <div class="theme-card" onclick="setTheme('light')" data-theme="light">
            <div class="theme-swatch" style="background:linear-gradient(135deg,#f8f7f4,#e8e4de)"></div>
            Light
          </div>
          <div class="theme-card" onclick="setTheme('flat-dark')" data-theme="flat-dark">
            <div class="theme-swatch" style="background:#181818"></div>
            Flat Dark
          </div>
          <div class="theme-card" onclick="setTheme('flat-light')" data-theme="flat-light">
            <div class="theme-swatch" style="background:#ffffff;border:1px solid rgba(0,0,0,0.08)"></div>
            Flat Light
          </div>
        </div>
        <div class="settings-subgrid">
          <div class="settings-field">
