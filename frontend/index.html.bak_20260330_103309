.docs-card{padding:14px 16px;border-radius:16px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06);}
.docs-card h4{margin:0 0 8px;font-size:14px;color:#f2f6ff;}
.docs-card p{margin:0;font-size:12px;color:#b8c4dc;line-height:1.75;}
.docs-list{display:grid;gap:8px;margin-top:6px;}
.docs-bullet{display:flex;align-items:flex-start;gap:10px;font-size:13px;line-height:1.75;color:#d6e0f3;}
.docs-bullet svg{width:15px;height:15px;color:#99aeff;flex-shrink:0;margin-top:4px;}
.docs-chip-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;}
.docs-chip{padding:8px 10px;border-radius:999px;background:rgba(146,167,255,0.12);border:1px solid rgba(146,167,255,0.18);font-size:11px;font-weight:700;color:#dce6ff;text-transform:uppercase;letter-spacing:.08em;}
#panel-docs{display:none;}
#panel-docs .panel-title{display:flex;align-items:center;justify-content:space-between;gap:10px;}
#panel-docs .docs-scroll{padding:0;display:grid;gap:12px;overflow:visible;}
#panel-docs .docs-section{padding:14px;border-radius:16px;}
#panel-docs .docs-section h3{font-size:16px;margin-bottom:8px;}
#panel-docs .docs-section p{font-size:12px;line-height:1.7;}
#panel-docs .docs-grid{grid-template-columns:1fr;}
.panel-docs-links{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;}
.panel-docs-link{height:28px;padding:0 10px;border-radius:999px;border:1px solid var(--border2);background:rgba(255,255,255,0.04);color:var(--text2);font-family:var(--font);font-size:11px;font-weight:700;cursor:pointer;}
.panel-docs-link:hover{background:var(--surface3);color:var(--text);}
.panel-docs-body{display:grid;gap:12px;}
@media (max-width:920px){
  .docs-box{grid-template-columns:1fr;}
  .docs-sidebar{border-right:none;border-bottom:1px solid rgba(255,255,255,0.06);}
  .docs-grid{grid-template-columns:1fr;}
}
/* ══ VERSION DIFF ══ */
.ver-diff-modal{position:fixed;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);z-index:600;display:none;align-items:center;justify-content:center;}
