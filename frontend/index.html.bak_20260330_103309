async function fetchNoteForAction(noteId){
  if(!noteId)return null;
  if(currentNote?.id===noteId)return currentNote;
  return api('GET',`/notes/${noteId}`);
}

function getLiveNotePayload(note){
  if(currentNote?.id===note?.id){
    return {
      title:document.getElementById('note-title')?.value||note.title||'Untitled',
      content:getEditorContent(),
      folder:currentNote.folder||note.folder||'Notes',
      tags:[...(currentNote.tags||note.tags||[])],
      properties:normalizeNoteProperties(currentNote.properties||note.properties||{})
    };
  }
  return {
    title:note.title||'Untitled',
    content:note.content||'',
    folder:note.folder||'Notes',
    tags:[...(note.tags||[])],
    properties:normalizeNoteProperties(note.properties||{})
  };
}

async function renameNotePrompt(noteId=currentNote?.id){
  const note=await fetchNoteForAction(noteId);
  if(!note)return;
  openQuickSheet({
    title:'Rename Note',
    subtitle:'Give this note a better name without leaving the list.',
    submitLabel:'Rename',
    fields:[{id:'title',label:'Title',value:note.title||'Untitled'}],
    onSubmit:async({title})=>{
      const nextTitle=(title||'').trim();
      if(!nextTitle || nextTitle===note.title)return;
      const payload=getLiveNotePayload(note);
      await api('PUT',`/notes/${note.id}`,{
        title:nextTitle,
        content:payload.content,
        folder:payload.folder,
        tags:payload.tags,
        properties:payload.properties
      });
      await loadAllNotes(currentFolderFilter);
      if(currentNote?.id===note.id)await openNote(note.id);
      showNotif('Note renamed');
    }
  });
}

async function duplicateNote(noteId=currentNote?.id){
  const note=await fetchNoteForAction(noteId);
  if(!note)return;
  const payload=getLiveNotePayload(note);
  const copy=await api('POST','/notes',{
    title:`${payload.title||'Untitled'} Copy`,
    content:payload.content,
    folder:payload.folder,
    tags:[...payload.tags],
    properties:{...payload.properties}
  });
  await loadAllNotes(currentFolderFilter);
  await openNote(copy.id);
  showNotif('Note duplicated');
}

