}

function debounceSave(){
  document.getElementById('sb-saved').textContent='Editing…';
  clearTimeout(saveTimer);saveTimer=setTimeout(forceSave,parseInt(settings.autosaveDelay,10)||1200);
}

async function forceSave(){
  if(!currentNote)return;clearTimeout(saveTimer);
  const title=document.getElementById('note-title').value||'Untitled';
  const content=getEditorContent();
  try{
    const updated=await api('PUT',`/notes/${currentNote.id}`,{
      title,
      content,
      folder:currentNote.folder,
      tags:currentNote.tags,
      properties:normalizeNoteProperties(currentNote.properties||{})
    });
    updated.properties=normalizeNoteProperties(updated.properties||{});
    currentNote=updated;
    document.getElementById('sb-words').textContent=updated.word_count+' words';
    document.getElementById('sb-saved').textContent='Saved';
    document.getElementById('bc-folder').textContent=updated.folder;
    document.getElementById('sb-folder').textContent=updated.folder;
    document.getElementById('bc-title').textContent=title;
    const tab=document.querySelector(`.tab[data-id="${currentNote.id}"] .tab-title`);
    if(tab)tab.textContent=title;
    const idx=allNotes.findIndex(n=>n.id===currentNote.id);
    if(idx>=0)allNotes[idx]=updated;
    renderNoteList(allNotes);
    await renderFolders();
    loadOutline();
    loadPropertiesPanel(updated);
    loadTasksPanel(updated);
    updateTrustSurface();
    Sounds.save();
  }catch(e){document.getElementById('sb-saved').textContent='Error saving';}
}

