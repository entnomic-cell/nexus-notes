function formatMusicTime(seconds){
  if(!Number.isFinite(seconds)||seconds<0)return '0:00';
  const mins=Math.floor(seconds/60);
  const secs=Math.floor(seconds%60).toString().padStart(2,'0');
  return `${mins}:${secs}`;
}

function updateMusicChip(){
  document.getElementById('music-chip').classList.toggle('active',document.getElementById('music-player').classList.contains('open'));
}

function updateMusicPlayIcon(){
  document.getElementById('mp-play-icon').innerHTML=musicPlaying
    ?'<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>'
    :'<polygon points="5 3 19 12 5 21 5 3"/>';
}

function updateMusicNowPlaying(){
  const track=musicTracks[currentTrackIdx];
  document.getElementById('mp-track-name').textContent=track?track.name:'Select a track';
  document.getElementById('mp-artist-name').textContent=track?'Local playlist':'Add MP3, WAV, or M4A files';
}

function updateMusicProgress(){
  const current=musicAudio?.currentTime||0;
  const total=musicAudio?.duration||0;
  document.getElementById('mp-time-current').textContent=formatMusicTime(current);
  document.getElementById('mp-time-total').textContent=formatMusicTime(total);
  document.getElementById('mp-progress').value=total?String((current/total)*100):'0';
}

function getNextTrackIndex(direction=1){
  if(!musicTracks.length)return 0;
  if(musicShuffle&&musicTracks.length>1){
    let next=currentTrackIdx;
    while(next===currentTrackIdx){
      next=Math.floor(Math.random()*musicTracks.length);
    }
    return next;
  }
  return (currentTrackIdx+direction+musicTracks.length)%musicTracks.length;
}

function renderMusicPlaylist(){
  const el=document.getElementById('mp-playlist');
  updateMusicNowPlaying();
  updateMusicProgress();
  updateMusicPlayIcon();
  updateMusicChip();
  if(!musicTracks.length){
    el.innerHTML='<div class="mp-empty">No tracks yet. Add local audio files and they will stay in your playlist.</div>';
    return;
  }
  el.innerHTML=musicTracks.map((t,i)=>`
    <div class="mp-track-item ${(i===currentTrackIdx&&musicPlaying)?'playing':''}" onclick="musicPlayTrack(${i})">
      <svg viewBox="0 0 24 24" fill="${(i===currentTrackIdx&&musicPlaying)?'currentColor':'none'}" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      <span>${esc(t.name)}</span>
      <span class="mp-track-meta">${esc((t.type||'audio').replace('audio/',''))}</span>
      <button class="mp-track-remove" onclick="event.stopPropagation();deleteMusicTrack('${t.id}')">×</button>
    </div>`).join('');
}

function toggleMusicPlayer(){
  const p=document.getElementById('music-player');
  p.classList.toggle('open');
  updateMusicChip();
}

function openMusicDb(){
  return new Promise((resolve,reject)=>{
    const req=indexedDB.open(MUSIC_DB_NAME,1);
    req.onupgradeneeded=()=>{
      const db=req.result;
      if(!db.objectStoreNames.contains('tracks')){
        db.createObjectStore('tracks',{keyPath:'id'});
      }
    };
    req.onsuccess=()=>resolve(req.result);
    req.onerror=()=>reject(req.error);
  });
}

function normalizeMusicTrackRecord(track,index=0){
  const name=String(track?.name||`Track ${index+1}`);
  const type=String(track?.type||track?.blob?.type||guessAudioMimeType(name));
  return {...track,name,type};
}

function musicTrackToBlob(track){
  if(!track)return null;
  const type=String(track.type||track.blob?.type||guessAudioMimeType(track.name));
  if(track.blob instanceof Blob){
    return track.blob.type===type ? track.blob : track.blob.slice(0,track.blob.size,type);
  }
  if(track.data instanceof ArrayBuffer){
    return new Blob([track.data],{type});
  }
  if(ArrayBuffer.isView(track.data)){
    return new Blob([track.data.buffer],{type});
  }
  return null;
}

async function loadMusicLibrary(){
  try{
    const db=await openMusicDb();
    const tx=db.transaction('tracks','readonly');
    const store=tx.objectStore('tracks');
    const req=store.getAll();
    const rows=await new Promise((resolve,reject)=>{
      req.onsuccess=()=>resolve(req.result||[]);
      req.onerror=()=>reject(req.error);
    });
    musicTracks=rows.map(normalizeMusicTrackRecord).sort((a,b)=>(a.order||0)-(b.order||0));
    if(currentTrackIdx>=musicTracks.length)currentTrackIdx=Math.max(0,musicTracks.length-1);
    renderMusicPlaylist();
  }catch(e){
    musicTracks=[];
    renderMusicPlaylist();
  }
}

function setupMusicPlayer(){
  musicAudio=document.getElementById('music-audio');
  musicAudio.preload='metadata';
  musicAudio.volume=parseFloat(document.getElementById('mp-volume').value||'0.5');
  musicAudio.playbackRate=parseFloat(document.getElementById('mp-speed').value||'1');
  musicAudio.addEventListener('ended',async()=>{
    if(musicRepeat&&musicAudio.src){
      musicAudio.currentTime=0;
      await musicAudio.play().catch(()=>{});
      return;
    }
    if(musicTracks.length>1){
      await musicNext();
      return;
    }
    musicPlaying=false;
    renderMusicPlaylist();
    updateMusicProgress();
  });
  musicAudio.addEventListener('play',()=>{
    musicPlaying=true;
    renderMusicPlaylist();
  });
  musicAudio.addEventListener('pause',()=>{
    musicPlaying=false;
    renderMusicPlaylist();
  });
  musicAudio.addEventListener('timeupdate',()=>{
    if(!musicSeeking)updateMusicProgress();
  });
  musicAudio.addEventListener('loadedmetadata',updateMusicProgress);
  musicAudio.addEventListener('canplay',updateMusicNowPlaying);
  musicAudio.addEventListener('emptied',updateMusicProgress);
  musicAudio.addEventListener('error',()=>{
    const mediaError=musicAudio?.error;
    console.error('Music playback failed', {code:mediaError?.code, track:musicTracks[currentTrackIdx]});
    showNotif('Could not load this local track');
  });
  renderMusicPlaylist();
}

async function importMusicFiles(event){
  const files=Array.from(event.target.files||[]);
  if(!files.length)return;
  const db=await openMusicDb();
  const tx=db.transaction('tracks','readwrite');
  const store=tx.objectStore('tracks');
  let baseIndex=musicTracks.length;
  for(const file of files){
    const id=`track-${Date.now()}-${Math.random().toString(16).slice(2,8)}`;
    const type=file.type||guessAudioMimeType(file.name);
    // Store raw bytes as well as metadata so playback stays reliable in embedded
    // shells where persisted File/Blob objects can behave inconsistently.
    const data=await file.arrayBuffer();
    store.put({id,name:file.name.replace(/\.[^.]+$/,''),type,data,order:baseIndex++});
  }
  await new Promise((resolve,reject)=>{
    tx.oncomplete=resolve;
    tx.onerror=()=>reject(tx.error);
  });
  event.target.value='';
  await loadMusicLibrary();
  if(musicTracks.length&&!musicAudio.src)await musicPlayTrack(0);
  showNotif(`${files.length} track${files.length>1?'s':''} added`);
}

async function deleteMusicTrack(id){
  const deletingCurrent=musicTracks[currentTrackIdx]?.id===id;
  const db=await openMusicDb();
  const tx=db.transaction('tracks','readwrite');
  tx.objectStore('tracks').delete(id);
  await new Promise((resolve,reject)=>{
    tx.oncomplete=resolve;
    tx.onerror=()=>reject(tx.error);
  });
  if(musicTrackUrls[id]){
    URL.revokeObjectURL(musicTrackUrls[id]);
    delete musicTrackUrls[id];
  }
  await loadMusicLibrary();
  if(deletingCurrent){
    musicAudio.pause();
    musicAudio.removeAttribute('src');
    musicAudio.load();
    if(musicTracks.length)await musicPlayTrack(Math.min(currentTrackIdx,musicTracks.length-1));
  }
  renderMusicPlaylist();
}

async function musicPlayTrack(idx){
  if(!musicTracks.length){
    toggleMusicPlayer();
    return;
  }
  currentTrackIdx=Math.max(0,Math.min(idx,musicTracks.length-1));
  const track=musicTracks[currentTrackIdx];
  const blob=musicTrackToBlob(track);
  if(!blob){
    showNotif('This track could not be read');
    return;
  }
  if(!musicTrackUrls[track.id]){
    musicTrackUrls[track.id]=URL.createObjectURL(blob);
  }
  if(musicAudio.src!==musicTrackUrls[track.id]){
    musicAudio.src=musicTrackUrls[track.id];
    musicAudio.load();
  }
  updateMusicNowPlaying();
  updateMusicProgress();
  await musicAudio.play().catch(()=>{showNotif('Could not play this track');});
}

async function musicToggle(){
  if(!musicTracks.length){
    document.getElementById('music-file-input').click();
    return;
  }
  if(musicAudio.src&&musicPlaying){
    musicAudio.pause();
    return;
  }
  if(musicAudio.src){
    await musicAudio.play().catch(()=>{showNotif('Could not resume playback');});
    return;
  }
  await musicPlayTrack(currentTrackIdx||0);
}

async function musicNext(){
  if(!musicTracks.length)return;
  await musicPlayTrack(getNextTrackIndex(1));
}

async function musicPrev(){
  if(!musicTracks.length)return;
  await musicPlayTrack(getNextTrackIndex(-1));
}

function setVolume(v){
  if(musicAudio)musicAudio.volume=parseFloat(v);
}

function setPlaybackSpeed(v){
  if(musicAudio)musicAudio.playbackRate=parseFloat(v);
}

function beginMusicSeek(){
  musicSeeking=true;
}

function seekMusic(v){
  if(!musicAudio||!Number.isFinite(musicAudio.duration)||musicAudio.duration<=0)return;
  const nextTime=(parseFloat(v)/100)*musicAudio.duration;
  musicAudio.currentTime=nextTime;
  document.getElementById('mp-time-current').textContent=formatMusicTime(nextTime);
}

function endMusicSeek(v){
  seekMusic(v);
  musicSeeking=false;
  updateMusicProgress();
}

function toggleMusicShuffle(btn){
  musicShuffle=!musicShuffle;
  btn.classList.toggle('active',musicShuffle);
}

function toggleMusicRepeat(btn){
  musicRepeat=!musicRepeat;
  btn.classList.toggle('active',musicRepeat);
}

