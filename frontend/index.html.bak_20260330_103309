function getStrokeBounds(stroke){
  if(stroke?.tool==='image' && stroke.frame){
    return {minX:stroke.frame.x,minY:stroke.frame.y,maxX:stroke.frame.x+stroke.frame.width,maxY:stroke.frame.y+stroke.frame.height};
  }
  if(stroke?.type==='text' || stroke?.tool==='text'){
    const anchor=stroke?.points?.[0]||{x:0,y:0};
    const lines=String(stroke?.text||'').split(/\r?\n/).filter(Boolean);
    const fontSize=Math.max(14,Number(stroke?.metadata?.fontSize)||ptTextSize||30);
    const width=Math.max(...(lines.length?lines.map(line=>line.length):[4]))*fontSize*0.62;
