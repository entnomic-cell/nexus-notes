.tmpl-card-meta{display:flex;flex-wrap:wrap;gap:6px;}
.tmpl-card-chip{display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:999px;border:1px solid var(--border2);background:rgba(255,255,255,0.04);font-size:10px;font-weight:700;color:var(--text3);}
.tmpl-card-actions{margin-top:auto;display:flex;gap:8px;flex-wrap:wrap;}
.tmpl-card-btn{height:32px;padding:0 12px;border-radius:10px;border:1px solid var(--border2);background:transparent;color:var(--text2);font-family:var(--font);font-size:11px;cursor:pointer;}
.tmpl-card-btn.primary{background:linear-gradient(135deg,#8ec5ff,#5b8def);border-color:transparent;color:#07111f;font-weight:600;}
.tmpl-card-btn:hover{background:var(--surface3);color:var(--text);}
.tmpl-card-btn.primary:hover{opacity:.9;color:#07111f;}
.tmpl-empty{color:var(--text3);font-size:13px;padding:22px;border:1px dashed var(--border2);border-radius:18px;background:rgba(255,255,255,0.03);}
/* ══ EXPORT/IMPORT ══ */
