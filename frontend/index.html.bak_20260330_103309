function scheduleWelcomeKick(ctx, master, when, accent=1){
  try{
    const kick=ctx.createOscillator();
    const kickGain=ctx.createGain();
    kick.type='sine';
    kick.frequency.setValueAtTime(96*accent,when);
    kick.frequency.exponentialRampToValueAtTime(40,when+0.2);
    kickGain.gain.setValueAtTime(0.0001,when);
    kickGain.gain.exponentialRampToValueAtTime(0.055*accent,when+0.01);
    kickGain.gain.exponentialRampToValueAtTime(0.0001,when+0.22);
    kick.connect(kickGain);
    kickGain.connect(master);
    kick.start(when);
    kick.stop(when+0.24);
  }catch(_){}
}
function scheduleWelcomeSnare(ctx, master, when, accent=1){
  try{
    const noise=ctx.createBufferSource();
    noise.buffer=getWelcomeNoiseBuffer(ctx);
    const noiseFilter=ctx.createBiquadFilter();
    const noiseGain=ctx.createGain();
    noiseFilter.type='bandpass';
    noiseFilter.frequency.value=1220;
    noiseFilter.Q.value=0.6;
    noiseGain.gain.setValueAtTime(0.0001,when);
    noiseGain.gain.exponentialRampToValueAtTime(0.010*accent,when+0.014);
    noiseGain.gain.exponentialRampToValueAtTime(0.0001,when+0.18);
    noise.connect(noiseFilter);
    noiseFilter.connect(noiseGain);
    noiseGain.connect(master);
    noise.start(when);
    noise.stop(when+0.2);

    const tone=ctx.createOscillator();
    const toneGain=ctx.createGain();
    tone.type='triangle';
    tone.frequency.setValueAtTime(196,when);
    tone.frequency.exponentialRampToValueAtTime(122,when+0.12);
    toneGain.gain.setValueAtTime(0.0001,when);
    toneGain.gain.exponentialRampToValueAtTime(0.012*accent,when+0.015);
    toneGain.gain.exponentialRampToValueAtTime(0.0001,when+0.14);
    tone.connect(toneGain);
    toneGain.connect(master);
    tone.start(when);
    tone.stop(when+0.16);
  }catch(_){}
}
function scheduleWelcomeHat(ctx, master, when, accent=1, open=false){
  try{
    const noise=ctx.createBufferSource();
    noise.buffer=getWelcomeNoiseBuffer(ctx);
    const filter=ctx.createBiquadFilter();
    const toneFilter=ctx.createBiquadFilter();
    const gain=ctx.createGain();
    filter.type='lowpass';
    filter.frequency.value=open?2400:1800;
    filter.Q.value=0.35;
    toneFilter.type='highpass';
    toneFilter.frequency.value=open?900:700;
    gain.gain.setValueAtTime(0.0001,when);
    gain.gain.exponentialRampToValueAtTime((open?0.0016:0.0009)*accent,when+0.02);
    gain.gain.exponentialRampToValueAtTime(0.0001,when+(open?0.14:0.055));
    noise.connect(filter);
    filter.connect(toneFilter);
    toneFilter.connect(gain);
    gain.connect(master);
    noise.start(when);
    noise.stop(when+(open?0.16:0.07));
  }catch(_){}
}
function scheduleWelcomeBass(ctx, master, when, step){
  try{
    const chord=getWelcomeChord(step);
    const root=chord[0]/2;
    const choices=[root,root,root*(step%4===2?1.5:1),root];
    const freq=choices[step%4];
    const bass=ctx.createOscillator();
    const bassFilter=ctx.createBiquadFilter();
    const bassGain=ctx.createGain();
    bass.type='sawtooth';
    bass.frequency.setValueAtTime(freq,when);
    bassFilter.type='lowpass';
    bassFilter.frequency.value=260;
    bassGain.gain.setValueAtTime(0.0001,when);
    bassGain.gain.linearRampToValueAtTime(0.018,when+0.02);
    bassGain.gain.exponentialRampToValueAtTime(0.0001,when+0.34);
    bass.connect(bassFilter);
    bassFilter.connect(bassGain);
    bassGain.connect(master);
    bass.start(when);
    bass.stop(when+0.36);
  }catch(_){}
}
function triggerWelcomeBeat(ctx, master, step=0){
  try{
    const start=ctx.currentTime;
    const subStep=step%16;
    const kickPattern=[0,3,8,10,12,15];
    const hatPattern=[6,14];
    if(kickPattern.includes(subStep))scheduleWelcomeKick(ctx,master,start,subStep===0||subStep===8?1:0.82);
    if(subStep===4 || subStep===12)scheduleWelcomeSnare(ctx,master,start,subStep===12?1.08:1);
    if(hatPattern.includes(subStep))scheduleWelcomeHat(ctx,master,start+0.025,subStep===14?0.88:0.72,false);
    if(subStep===15)scheduleWelcomeHat(ctx,master,start+0.03,0.48,true);
    if([0,4,8,12].includes(subStep))scheduleWelcomeBass(ctx,master,start+0.01,step);
  }catch(_){}
}
function updateWelcomeHarmony(ctx, nodes, step){
  const chord=getWelcomeChord(step);
  nodes.forEach((node,index)=>{
    const target=chord[index]||chord[chord.length-1];
    try{
      node.osc.frequency.cancelScheduledValues(ctx.currentTime);
      node.osc.frequency.linearRampToValueAtTime(target,ctx.currentTime+0.18);
      node.lfo.frequency.cancelScheduledValues(ctx.currentTime);
      node.lfo.frequency.linearRampToValueAtTime(0.038+(index*0.012)+((step%32===16)?0.01:0),ctx.currentTime+0.24);
    }catch(_){}
  });
}
async function playWelcomeMusic(){
  if(!isWelcomeScreenOpen())return false;
  try{
    const Ctx=window.AudioContext||window.webkitAudioContext;
    if(!Ctx)return false;
    if(!welcomeIntroMusicCtx || welcomeIntroMusicCtx.state==='closed'){
      welcomeIntroMusicCtx=new Ctx();
      welcomeIntroMusicStarted=false;
    }
    const ctx=welcomeIntroMusicCtx;
    if(ctx.state==='suspended'){
      try{ await ctx.resume(); }catch(_){}
    }
    if(ctx.state==='suspended')return false;
    if(welcomeIntroMusicStarted && welcomeIntroMusicMaster){
      if(!welcomeIntroBeatTimer){
        updateWelcomeHarmony(ctx,welcomeIntroMusicNodes,welcomeIntroBeatStep);
        triggerWelcomeBeat(ctx,welcomeIntroMusicMaster,welcomeIntroBeatStep);
        welcomeIntroBeatTimer=setInterval(()=>{
          if(!isWelcomeScreenOpen() || welcomeIntroMusicCtx!==ctx){
            clearInterval(welcomeIntroBeatTimer);
            welcomeIntroBeatTimer=null;
            return;
          }
          welcomeIntroBeatStep+=1;
          updateWelcomeHarmony(ctx,welcomeIntroMusicNodes,welcomeIntroBeatStep);
          triggerWelcomeBeat(ctx,welcomeIntroMusicMaster,welcomeIntroBeatStep);
        },125);
      }
      return true;
    }
    const filter=ctx.createBiquadFilter();
    filter.type='lowpass';
    filter.frequency.value=980;
    filter.Q.value=0.24;
    const master=ctx.createGain();
    master.gain.setValueAtTime(0.0001,ctx.currentTime);
    filter.connect(master);
    master.connect(ctx.destination);
    const notes=[
      {freq:261.63,type:'triangle',level:0.095,attack:1.6,detune:-4,lfo:0.042},
      {freq:329.63,type:'sine',level:0.056,attack:2.0,detune:3,lfo:0.055},
      {freq:392.0,type:'sine',level:0.03,attack:2.4,detune:1,lfo:0.068}
    ];
    const nodes=notes.map(note=>{
      const osc=ctx.createOscillator();
      const gain=ctx.createGain();
      const lfo=ctx.createOscillator();
      const lfoGain=ctx.createGain();
      osc.type=note.type;
      osc.frequency.value=note.freq;
      osc.detune.value=note.detune;
      lfo.type='sine';
      lfo.frequency.value=note.lfo;
      lfoGain.gain.value=4;
      gain.gain.setValueAtTime(0.0001,ctx.currentTime);
      gain.gain.linearRampToValueAtTime(note.level,ctx.currentTime+note.attack);
      lfo.connect(lfoGain);
      lfoGain.connect(osc.detune);
      osc.connect(gain);
      gain.connect(filter);
      osc.start();
      lfo.start();
      return {osc,gain,lfo,lfoGain};
    });
    master.gain.linearRampToValueAtTime(0.03,ctx.currentTime+1.1);
    welcomeIntroBeatStep=0;
    updateWelcomeHarmony(ctx,nodes,welcomeIntroBeatStep);
    triggerWelcomeBeat(ctx,master,welcomeIntroBeatStep);
    welcomeIntroBeatTimer=setInterval(()=>{
      if(!isWelcomeScreenOpen() || welcomeIntroMusicCtx!==ctx){
        clearInterval(welcomeIntroBeatTimer);
        welcomeIntroBeatTimer=null;
        return;
      }
      welcomeIntroBeatStep+=1;
      updateWelcomeHarmony(ctx,nodes,welcomeIntroBeatStep);
      triggerWelcomeBeat(ctx,master,welcomeIntroBeatStep);
    },125);
    welcomeIntroMusicMaster=master;
    welcomeIntroMusicNodes=nodes;
    welcomeIntroMusicStarted=true;
    return true;
  }catch(_){
    return false;
  }
}
function stopWelcomeMusic(){
  if(welcomeIntroBeatTimer){
    clearInterval(welcomeIntroBeatTimer);
    welcomeIntroBeatTimer=null;
  }
  if(!welcomeIntroMusicCtx)return;
  try{
    const ctx=welcomeIntroMusicCtx;
    const stopAt=ctx.currentTime+0.45;
    if(welcomeIntroMusicMaster){
      welcomeIntroMusicMaster.gain.cancelScheduledValues(ctx.currentTime);
      welcomeIntroMusicMaster.gain.setValueAtTime(Math.max(welcomeIntroMusicMaster.gain.value,0.0001),ctx.currentTime);
      welcomeIntroMusicMaster.gain.exponentialRampToValueAtTime(0.0001,stopAt);
    }
    welcomeIntroMusicNodes.forEach(node=>{
      try{ node.gain.gain.cancelScheduledValues(ctx.currentTime); }catch(_){}
      try{ node.gain.gain.exponentialRampToValueAtTime(0.0001,stopAt); }catch(_){}
      try{ node.osc.stop(stopAt+0.08); }catch(_){}
      try{ node.lfo.stop(stopAt+0.08); }catch(_){}
    });
    setTimeout(()=>{
      if(welcomeIntroMusicCtx===ctx){
        try{ ctx.close().catch(()=>{}); }catch(_){}
        welcomeIntroMusicCtx=null;
        welcomeIntroMusicMaster=null;
        welcomeIntroMusicNodes=[];
        welcomeIntroMusicStarted=false;
        welcomeIntroBeatStep=0;
      }
    },620);
  }catch(_){
    welcomeIntroMusicCtx=null;
    welcomeIntroMusicMaster=null;
    welcomeIntroMusicNodes=[];
    welcomeIntroMusicStarted=false;
    welcomeIntroBeatTimer=null;
    welcomeIntroBeatStep=0;
  }
}
