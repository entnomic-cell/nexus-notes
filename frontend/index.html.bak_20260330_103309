}
function getSketchBounds(doc){
  const block=getPrimarySketchBlock(doc);
  let minX=Infinity,minY=Infinity,maxX=-Infinity,maxY=-Infinity;
  block.strokes.forEach(stroke=>{
    if(stroke.tool==='image'&&stroke.frame){
      minX=Math.min(minX,stroke.frame.x);minY=Math.min(minY,stroke.frame.y);maxX=Math.max(maxX,stroke.frame.x+stroke.frame.width);maxY=Math.max(maxY,stroke.frame.y+stroke.frame.height);return;
    }
    if(stroke.type==='text' || stroke.tool==='text'){
      const anchor=stroke.points?.[0];
      if(anchor){
        const lines=String(stroke.text||'').split(/\r?\n/).filter(Boolean);
        const fontSize=Math.max(14,Number(stroke.metadata?.fontSize)||ptTextSize||30);
        const textWidth=Math.max(...(lines.length?lines.map(line=>line.length):[4]))*fontSize*0.62;
        const textHeight=Math.max(1,lines.length)*fontSize*1.22;
        minX=Math.min(minX,anchor.x);
        minY=Math.min(minY,anchor.y);
        maxX=Math.max(maxX,anchor.x+textWidth);
        maxY=Math.max(maxY,anchor.y+textHeight);
      }
      return;
    }
    stroke.points.forEach(point=>{minX=Math.min(minX,point.x);minY=Math.min(minY,point.y);maxX=Math.max(maxX,point.x);maxY=Math.max(maxY,point.y);});
  });
  if(!Number.isFinite(minX))return {minX:0,minY:0,maxX:block.size.width,maxY:block.size.height,width:block.size.width,height:block.size.height};
  return {minX,minY,maxX,maxY,width:Math.max(240,maxX-minX),height:Math.max(180,maxY-minY)};
}
function fitSketchViewport(doc,viewportWidth,viewportHeight,padding=80){
