function loadOutline(){
  const headings=[...document.querySelectorAll('#editor-content h1,#editor-content h2,#editor-content h3')];
  const panel=document.getElementById('panel-outline');
  const list=document.getElementById('outline-list');
  if(!headings.length){
    panel.style.display='none';
    list.innerHTML='';
    return;
  }
  panel.style.display='block';
  list.innerHTML=headings.map((heading,idx)=>{
    heading.dataset.outlineId=`outline-${idx}`;
    const level=parseInt(heading.tagName.slice(1),10);
    return `<div class="backlink-item" style="margin-left:${(level-1)*10}px" onclick="jumpToOutline('${heading.dataset.outlineId}')"><div class="backlink-title">${esc(heading.textContent||'Section')}</div></div>`;
  }).join('');
}

function jumpToOutline(id){
  document.querySelector(`[data-outline-id="${id}"]`)?.scrollIntoView({behavior:'smooth',block:'center'});
}

async function loadBacklinks(id){
  const data=await api('GET',`/notes/${id}/backlinks`);
  const el=document.getElementById('backlinks-list');
  const sec=document.getElementById('panel-backlinks');
  const all=[...data.incoming,...data.outgoing];
  if(!all.length){sec.style.display='none';return;}
  sec.style.display='block';el.innerHTML='';
  if(data.incoming.length){
    el.innerHTML+=`<div style="font-size:10px;color:var(--text3);margin-bottom:6px;text-transform:uppercase;letter-spacing:0.06em">Incoming (${data.incoming.length})</div>`;
    data.incoming.forEach(b=>{el.innerHTML+=`<div class="backlink-item" onclick="openNote('${b.id}')"><div class="backlink-title">${esc(b.title)}</div><div class="backlink-preview">${esc((b.preview||'').slice(0,100))}</div></div>`;});
  }
  if(data.outgoing.length){
    el.innerHTML+=`<div style="font-size:10px;color:var(--text3);margin:10px 0 6px;text-transform:uppercase;letter-spacing:0.06em">Outgoing (${data.outgoing.length})</div>`;
    data.outgoing.forEach(b=>{
      if(b.id){
        el.innerHTML+=`<div class="backlink-item" onclick="openNote('${b.id}')"><div class="backlink-title">${esc(b.title)}</div></div>`;
      }else{
        el.innerHTML+=`<div class="backlink-item"><div class="backlink-title">${esc(b.title)}</div><div class="backlink-preview">Unresolved link</div></div>`;
      }
    });
  }
}

