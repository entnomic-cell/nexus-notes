  if((ptShapeKind==='ellipse'||ptShapeKind==='auto') && closed && Math.abs(width-height)<Math.max(60,Math.min(width,height)*0.38))return normalizeSketchStroke({id:sketchUid('stroke'),type:'shape',tool:'shape',shape:'ellipse',color:ptColor,width:ptBrushSize,opacity:ptOpacity,points:[{x:box.minX,y:box.minY},{x:box.maxX,y:box.maxY}],timestamp:Date.now()});
  if((ptShapeKind==='rect'||ptShapeKind==='auto') && closed && width>24 && height>24)return normalizeSketchStroke({id:sketchUid('stroke'),type:'shape',tool:'shape',shape:'rect',color:ptColor,width:ptBrushSize,opacity:ptOpacity,points:[{x:box.minX,y:box.minY},{x:box.maxX,y:box.maxY}],timestamp:Date.now()});
