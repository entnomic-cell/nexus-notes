function htmlToMarkdown(html){
  return html
    .replace(/<h1[^>]*>(.*?)<\/h1>/gi,'# $1\n')
    .replace(/<h2[^>]*>(.*?)<\/h2>/gi,'## $1\n')
    .replace(/<h3[^>]*>(.*?)<\/h3>/gi,'### $1\n')
    .replace(/<strong[^>]*>(.*?)<\/strong>/gi,'**$1**')
    .replace(/<em[^>]*>(.*?)<\/em>/gi,'*$1*')
    .replace(/<code[^>]*>(.*?)<\/code>/gi,'`$1`')
    .replace(/<a[^>]*href="([^"]*)"[^>]*>(.*?)<\/a>/gi,'[$2]($1)')
    .replace(/<li[^>]*>(.*?)<\/li>/gi,'- $1\n')
    .replace(/<br\s*\/?>/gi,'\n')
    .replace(/<[^>]+>/g,'')
    .replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').replace(/&#39;/g,"'")
    .replace(/\n{3,}/g,'\n\n').trim();
}
function exportNote(fmt){
  if(!currentNote){showNotif('No note open');return;}
  const title=currentNote.title||'note';
  const content=document.getElementById('editor-content').innerHTML;
  let text,mime,ext;
  if(fmt==='markdown'){
    text=`---\ntitle: ${title}\ntags: ${(currentNote.tags||[]).join(', ')}\nfolder: ${currentNote.folder}\n---\n\n# ${title}\n\n${htmlToMarkdown(content)}`;
    mime='text/markdown';ext='.md';
  }else if(fmt==='html'){
    text=`<!DOCTYPE html><html><head><meta charset="UTF-8"><title>${esc(title)}</title></head><body><h1>${esc(title)}</h1>${content}</body></html>`;
    mime='text/html';ext='.html';
  }else{
    text=`${title}\n${'─'.repeat(title.length)}\n\n${htmlToMarkdown(content)}`;
    mime='text/plain';ext='.txt';
  }
  const blob=new Blob([text],{type:mime});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download=title.replace(/[^a-z0-9]/gi,'_')+ext;
  a.click();URL.revokeObjectURL(a.href);
  showNotif(`Exported as ${ext} ✓`);
}
function downloadJsonFile(filename,payload){
  const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download=filename;
  a.click();
  URL.revokeObjectURL(a.href);
}
function normalizeImportedContent(item){
  let content=typeof item.content==='string'?item.content:'';
  if(!content&&typeof item.body==='string')content=markdownToHtml(item.body);
  if(content && !/<[a-z][\s\S]*>/i.test(content))content=plainTextToHtml(content);
  return content;
}
async function ensureImportedFolders(folders,notes){
  const names=new Set(['Notes','Inbox']);
  (Array.isArray(folders)?folders:[]).forEach(folder=>{
    const value=typeof folder==='string'?folder:folder?.name||folder?.folder;
    if(value)names.add(String(value).trim());
  });
  (Array.isArray(notes)?notes:[]).forEach(note=>{
    if(note?.folder)names.add(String(note.folder).trim());
  });
  for(const name of names){
    if(!name)continue;
    await api('POST','/folders',{name}).catch(()=>{});
  }
}
function remapCalendarEventsSetting(rawValue,idMap){
  if(!rawValue)return rawValue;
  try{
    const parsed=typeof rawValue==='string'?JSON.parse(rawValue):rawValue;
    if(!Array.isArray(parsed))return rawValue;
    return JSON.stringify(parsed.map(eventItem=>({
      ...eventItem,
      note_id:idMap.get(eventItem.note_id)||eventItem.note_id||''
    })));
  }catch(_){
    return rawValue;
  }
}
