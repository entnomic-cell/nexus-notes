function mmAddNode(){
  mmSelected=mmSelected&&mmNodes.some(node=>node.id===mmSelected)?mmSelected:(mmNodes[0]?.id||null);
  mmNodeCount++;
  const id=String(mmNodeCount);
  const color=document.getElementById('mm-node-color-btn').dataset.color||'#c8a96e';
  const shape=document.getElementById('mm-node-shape').value||'ellipse';
  const parent=mmParentOf(mmSelected)||mmSelected;
  const base=mmNodes.find(node=>node.id===parent)||mmNodes.find(node=>node.id===mmSelected)||{x:320,y:240};
  mmNodes.push(mmNormalizeNode({id,text:'New Node',x:base.x+180,y:base.y+90,color,shape,labelStyle:document.getElementById('mm-node-style')?.value||'normal'}));
  mmSelected=id;
  mmCommitChange({autoLayout:mmMeta.layoutMode==='tree'});
}

function mmAddChild(parentId=mmSelected){
  if(!parentId){
    mmAddNode();
    return;
  }
  const parent=mmNodes.find(node=>node.id===parentId);
  if(!parent)return;
  mmNodeCount++;
  const id=String(mmNodeCount);
  const color=document.getElementById('mm-node-color-btn').dataset.color||parent.color||'#c8a96e';
  const shape=document.getElementById('mm-node-shape').value||parent.shape||'ellipse';
  mmNodes.push(mmNormalizeNode({id,text:'New Node',x:parent.x+180,y:parent.y+90,color,shape,labelStyle:document.getElementById('mm-node-style')?.value||'normal'}));
  mmEdges=mmNormalizeEdges([...mmEdges,{from:parentId,to:id}]);
  parent.collapsed=false;
  mmSelected=id;
  mmCommitChange({autoLayout:true});
}

function mmDeleteSelected(){
  if(!mmSelected)return;
  mmNodes=mmNodes.filter(n=>n.id!==mmSelected);
  mmEdges=mmEdges.filter(e=>e.from!==mmSelected&&e.to!==mmSelected);
  mmSelected=null;
  mmConnectFrom=null;
  mmCommitChange({autoLayout:mmMeta.layoutMode==='tree'});
