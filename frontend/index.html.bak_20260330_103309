async function loadSettingsFromServer(){
  try{
    const s=await api('GET','/settings');
    settings={...SETTINGS_DEFAULTS};
    Object.keys(SETTINGS_DEFAULTS).forEach(key=>{
      settings[key]=normalizeSettingValue(key,s[key]);
    });
    if(s.aiMode && AI_WEBSITE_PROVIDERS[s.aiMode]) aiMode=s.aiMode;
    else aiMode='duck';
    settings.aiMode=aiMode;
    if(typeof s.calendarEvents==='string' && s.calendarEvents.trim()){
      try{
        const parsed=JSON.parse(s.calendarEvents);
        calendarEvents=Array.isArray(parsed)?parsed.sort(calendarSortEvents):[];
      }catch(_){
        calendarEvents=[];
      }
    }else{
      calendarEvents=[];
    }
    if(s.gDriveClientId){ gDriveClientId=s.gDriveClientId; }
    if(s.sidebarWidth)document.documentElement.style.setProperty('--sidebar-w',`${parseInt(s.sidebarWidth,10)||240}px`);
    if(s.rightPanelWidth)document.documentElement.style.setProperty('--right-panel-w',`${parseInt(s.rightPanelWidth,10)||280}px`);
    if(s.duckSidebarWidth)document.documentElement.style.setProperty('--duck-sidebar-w',`${parseInt(s.duckSidebarWidth,10)||420}px`);
    if(s.statusbarHeight){
      const statusbarHeight=normalizeStatusbarHeight(s.statusbarHeight);
      document.documentElement.style.setProperty('--statusbar-h',`${statusbarHeight}px`);
      if(statusbarHeight!==parseInt(s.statusbarHeight,10))api('PUT','/settings',{statusbarHeight}).catch(()=>{});
    }
    const gdriveInput=document.getElementById('gdrive-client-id');
    if(gdriveInput)gdriveInput.value=gDriveClientId;
    welcomeSeen=parseStoredBoolean(s.welcome_seen);
    lastBackupAt=String(s.lastBackupAt||'');
    focusTimerRuntime=normalizeFocusTimerRuntime(s.focusTimerRuntime);
    focusTimerHistory=normalizeFocusTimerHistory(s.focusTimerHistory);
  }catch(e){}
  syncSettingsControls();
  applyWorkspaceSettings();
  updateAIModeToggle();
  updateTrustSurface();
  renderFocusTimer();
}

