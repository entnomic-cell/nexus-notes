  ctx.clearRect(0,0,metrics.width,metrics.height);
  ctx.save();
  ctx.translate(ptViewport.x,ptViewport.y);
  ctx.scale(ptViewport.zoom,ptViewport.zoom);
  const block=getPrimarySketchBlock(ptDoc);
  block.strokes.forEach(stroke=>drawSketchStroke(ctx,stroke,ptSelectionIds.has(stroke.id)));
  if(ptCurrentStroke)drawSketchStroke(ctx,ptCurrentStroke,false);
