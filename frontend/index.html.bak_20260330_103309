function buildInlineChartHtml(labels, values){
  const pairs=labels.map((label,idx)=>({label,value:values[idx]??0})).filter(pair=>pair.label);
  const max=Math.max(1,...pairs.map(pair=>Math.max(0,pair.value)));
  const summary='Chart data: '+pairs.map(pair=>`${pair.label} ${pair.value}`).join(', ');
  const bars=pairs.map(pair=>{
    const height=Math.max(22,Math.round((Math.max(0,pair.value)/max)*132)+16);
    return `<div class="inline-chart-col"><div class="inline-chart-value">${esc(pair.value)}</div><div class="inline-chart-bar" style="height:${height}px"></div><div class="inline-chart-label">${esc(pair.label)}</div></div>`;
  }).join('');
  return `<div class="inline-chart" contenteditable="false" data-chart-summary="${esc(summary)}"><div class="inline-chart-header"><div class="inline-chart-title">Quick Chart</div><div class="inline-chart-value">${esc(summary.replace('Chart data: ',''))}</div></div><div class="inline-chart-grid">${bars}</div></div><p><br></p>`;
}

function insertChart(){
