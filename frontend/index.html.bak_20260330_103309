async function restoreVersion(vid){
  if(!currentNote)return;
  if(!await confirmSheet({title:'Restore Version',subtitle:'Replace the current note body with this older version?',confirmLabel:'Restore',tone:'primary'}))return;
  await forceSave();
  await api('POST',`/notes/${currentNote.id}/versions/${vid}/restore`);
  const note=await api('GET',`/notes/${currentNote.id}`);
  currentNote=note;setEditorContent(note.content);
  showNotif('Version restored');loadVersions(currentNote.id);
}

