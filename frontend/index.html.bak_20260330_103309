    const bounds=getStrokeBounds(stroke);
    const left=ptViewport.x+bounds.minX*ptViewport.zoom;
    const top=ptViewport.y+bounds.minY*ptViewport.zoom;
    const width=(bounds.maxX-bounds.minX)*ptViewport.zoom;
    const height=(bounds.maxY-bounds.minY)*ptViewport.zoom;
