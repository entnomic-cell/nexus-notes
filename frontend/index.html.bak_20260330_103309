<!-- ════ MUSIC PLAYER ════ -->
<div id="music-player">
  <div class="mp-header">
    <div>
      <div class="mp-title">Playlist</div>
      <div class="mp-subtitle">Local audio that plays inside the app</div>
    </div>
    <button class="mp-close" onclick="toggleMusicPlayer()">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="mp-actions">
    <button class="mp-upload" onclick="document.getElementById('music-file-input').click()">Add Tracks</button>
  </div>
  <div class="mp-now-playing">
    <div class="mp-track" id="mp-track-name">Select a track</div>
    <div class="mp-artist" id="mp-artist-name">Local playlist</div>
  </div>
  <div class="mp-controls">
    <button class="mp-btn" onclick="musicPrev()" title="Previous">
      <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="19 20 9 12 19 4 19 20"/><line x1="5" y1="19" x2="5" y2="5" stroke="currentColor" stroke-width="2" fill="none"/></svg>
    </button>
    <button class="mp-btn play" onclick="musicToggle()" id="mp-play-btn">
      <svg viewBox="0 0 24 24" fill="currentColor" id="mp-play-icon"><polygon points="5 3 19 12 5 21 5 3"/></svg>
    </button>
    <button class="mp-btn" onclick="musicNext()" title="Next">
      <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="5 4 15 12 5 20 5 4"/><line x1="19" y1="5" x2="19" y2="19" stroke="currentColor" stroke-width="2" fill="none"/></svg>
    </button>
  </div>
  <div class="mp-secondary">
    <div class="mp-secondary-actions">
      <button class="mp-toggle" id="mp-shuffle-btn" onclick="toggleMusicShuffle(this)">Shuffle</button>
      <button class="mp-toggle" id="mp-repeat-btn" onclick="toggleMusicRepeat(this)">Repeat</button>
    </div>
    <select class="mp-speed" id="mp-speed" onchange="setPlaybackSpeed(this.value)">
      <option value="0.8">0.8x</option>
      <option value="1" selected>1.0x</option>
      <option value="1.25">1.25x</option>
      <option value="1.5">1.5x</option>
    </select>
  </div>
  <div class="mp-progress-wrap">
    <input type="range" class="mp-progress" id="mp-progress" min="0" max="100" value="0" oninput="seekMusic(this.value)" onmousedown="beginMusicSeek()" onmouseup="endMusicSeek(this.value)" ontouchstart="beginMusicSeek()" ontouchend="endMusicSeek(this.value)">
    <div class="mp-time-row">
      <span id="mp-time-current">0:00</span>
      <span id="mp-time-total">0:00</span>
    </div>
  </div>
  <input type="range" class="mp-volume" id="mp-volume" min="0" max="1" step="0.05" value="0.5" oninput="setVolume(this.value)">
  <div class="mp-playlist" id="mp-playlist"></div>
  <input type="file" id="music-file-input" accept="audio/*" multiple hidden onchange="importMusicFiles(event)">
  <audio id="music-audio" hidden></audio>
</div>

