                ${eventItem.location?`<div class="cal-event-location">${esc(eventItem.location)}</div>`:''}
              </div>
            </div>
          </div>
          ${eventItem.description?`<div class="cal-event-desc">${esc(eventItem.description)}</div>`:''}
          <div class="cal-card-actions">
            <button class="cal-card-btn" onclick="openCalendarEventSheet('${eventItem.id}')">Edit</button>
