let graphData=null,graphTransform={x:0,y:0,scale:1},graphDragging=false,graphDragStart={};

async function openGraph(){
  document.getElementById('graph-view').classList.add('open');
  graphData=await api('GET','/graph');
  renderGraph();
}
function closeGraph(){document.getElementById('graph-view').classList.remove('open');}

function renderGraph(){
  const canvas=document.getElementById('graph-canvas');
  const rect=canvas.getBoundingClientRect();
  canvas.width=rect.width;canvas.height=rect.height;
  const ctx=canvas.getContext('2d');
  if(!graphData?.nodes?.length){ctx.fillStyle='#8a8780';ctx.font='14px DM Sans';ctx.textAlign='center';ctx.fillText('No notes yet',canvas.width/2,canvas.height/2);return;}

  const W=canvas.width,H=canvas.height;
  const nodes=graphData.nodes.map((n,i)=>({...n,x:W/2+Math.cos(i*2*Math.PI/graphData.nodes.length)*Math.min(W,H)*0.35,y:H/2+Math.sin(i*2*Math.PI/graphData.nodes.length)*Math.min(W,H)*0.3,r:8+Math.min(n.word_count||0,2000)/200}));
  const nodeMap=Object.fromEntries(nodes.map(n=>[n.id,n]));

  // Simple force simulation
  for(let iter=0;iter<80;iter++){
    nodes.forEach(a=>nodes.forEach(b=>{
      if(a===b)return;
      const dx=a.x-b.x,dy=a.y-b.y,d=Math.sqrt(dx*dx+dy*dy)||1;
      const f=200/d/d;a.x+=f*dx;a.y+=f*dy;
    }));
    graphData.edges.forEach(e=>{
      const a=nodeMap[e.source],b=nodeMap[e.target];
      if(!a||!b)return;
      const dx=a.x-b.x,dy=a.y-b.y,d=Math.sqrt(dx*dx+dy*dy)||1;
      const f=(d-100)/100*0.1;
      a.x-=f*dx;a.y-=f*dy;b.x+=f*dx;b.y+=f*dy;
    });
    nodes.forEach(n=>{n.x=Math.max(30,Math.min(W-30,n.x));n.y=Math.max(20,Math.min(H-20,n.y));});
  }

  const FOLDER_COLORS={Research:'#9b7fe8',Meetings:'#5b8def',Dev:'#4ecdc4',Personal:'#6bcb77',Notes:'#c8a96e'};
  ctx.clearRect(0,0,W,H);
  ctx.save();ctx.translate(graphTransform.x,graphTransform.y);ctx.scale(graphTransform.scale,graphTransform.scale);

  // Edges
  graphData.edges.forEach(e=>{
    const a=nodeMap[e.source],b=nodeMap[e.target];
    if(!a||!b)return;
    ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);
    ctx.strokeStyle='rgba(255,255,255,0.12)';ctx.lineWidth=1;ctx.stroke();
  });

  // Nodes
  nodes.forEach(n=>{
    const color=FOLDER_COLORS[n.folder]||'#c8a96e';
    ctx.beginPath();ctx.arc(n.x,n.y,n.r,0,Math.PI*2);
    ctx.fillStyle=color+'33';ctx.fill();
    ctx.strokeStyle=color;ctx.lineWidth=2;ctx.stroke();
    ctx.fillStyle='rgba(232,230,225,0.9)';ctx.font='11px DM Sans';ctx.textAlign='center';
    ctx.fillText(n.title.slice(0,20),n.x,n.y+n.r+14);
  });
  ctx.restore();
}

