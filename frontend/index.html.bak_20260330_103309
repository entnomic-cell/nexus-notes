async function importBackupJson(e){
  const file=e.target.files?.[0];
  if(!file)return;
  try{
    const raw=JSON.parse(await file.text());
    const notes=Array.isArray(raw)?raw:(Array.isArray(raw.notes)?raw.notes:[]);
    if(!notes.length){showNotif('No notes found in backup');return;}
    await ensureImportedFolders(raw.folders,notes);
    let count=0;
    const idMap=new Map();
    for(const item of notes){
      const title=String(item.title||item.name||'Untitled').trim()||'Untitled';
      const tags=Array.isArray(item.tags)?item.tags.map(String):String(item.tags||'').split(',').map(t=>t.trim()).filter(Boolean);
      const payload={
        id:item.id||item.note_id||'',
        title,
        content:normalizeImportedContent(item),
        folder:String(item.folder||'Imported').trim()||'Imported',
        tags,
        properties:normalizeNoteProperties(item.properties||{}),
        created_at:item.created_at||'',
        updated_at:item.updated_at||''
      };
      let created=null;
      try{
        created=await api('POST','/notes',payload);
      }catch(_){
        delete payload.id;
        delete payload.created_at;
        delete payload.updated_at;
        created=await api('POST','/notes',payload).catch(()=>null);
      }
      if(created){
        idMap.set(item.id||item.note_id||created.id,created.id);
        count++;
      }
    }
    await api('POST','/notes/rebuild-links',{}).catch(()=>{});
    if(raw.settings && typeof raw.settings==='object'){
      const nextSettings={...raw.settings};
      if(nextSettings.calendarEvents){
        nextSettings.calendarEvents=remapCalendarEventsSetting(nextSettings.calendarEvents,idMap);
      }
      await api('PUT','/settings',nextSettings).catch(()=>{});
    }
    if(Array.isArray(raw.bookmarks)){
      for(const bookmark of raw.bookmarks){
        const noteId=idMap.get(bookmark.note_id)||bookmark.note_id;
        if(!noteId)continue;
        await api('POST','/bookmarks',{note_id:noteId,label:bookmark.label||''}).catch(()=>{});
      }
    }
    if(Array.isArray(raw.mindmaps)){
      for(const map of raw.mindmaps){
        await api('POST','/mindmaps',{title:map.title||'Untitled Map',data:map.data||{nodes:[],edges:[]}}).catch(()=>{});
      }
    }
    if(Array.isArray(raw.painter_saves)){
      for(const drawing of raw.painter_saves){
        await api('POST','/painter',{title:drawing.title||'Untitled Drawing',image_data:drawing.image_data||'',vector_data:drawing.vector_data||{},metadata:drawing.metadata||{}}).catch(()=>{});
      }
    }
    if(Array.isArray(raw.custom_templates)){
      customTemplates=raw.custom_templates.map(t=>normalizeTemplateRecord({...t,_custom:true}));
      persistCustomTemplates();
    }
    lastBackupAt=raw.exported_at||new Date().toISOString();
    persistSetting('lastBackupAt',lastBackupAt);
    await loadSettingsFromServer();
    await loadAllNotes();
    await loadBookmarks();
    await loadStats();
    renderCalendar();
    closeExportModal();
    showNotif(`Imported ${count} notes`);
  }catch(err){
    showNotif('Backup import failed');
  }finally{
    e.target.value='';
    updateTrustSurface();
  }
}
