function openQuickSheet(config){
  quickSheetState={...(config||{}),submitting:false};
  document.getElementById('quick-sheet-title').textContent=config.title||'Action';
  document.getElementById('quick-sheet-subtitle').textContent=config.subtitle||'';
  const form=document.getElementById('quick-sheet-form');
  form.innerHTML=(config.fields||[]).map(field=>{
    if(field.type==='grid-start')return '<div class="quick-sheet-grid">';
    if(field.type==='grid-end')return '</div>';
    if(field.type==='action-grid'){
      return `<div class="quick-sheet-action-grid">${(field.actions||[]).map(action=>`<button type="button" class="quick-sheet-action-card" onclick="runQuickSheetAction('${esc(field.id||'actions')}','${esc(action.id||action.label||'action')}')"><div class="quick-sheet-action-title">${esc(action.label||'Action')}</div>${action.description?`<div class="quick-sheet-action-copy">${esc(action.description)}</div>`:''}</button>`).join('')}</div>`;
    }
    const input=field.multiline
      ?`<textarea class="quick-sheet-textarea" id="qs-${field.id}" placeholder="${esc(field.placeholder||'')}">${esc(field.value||'')}</textarea>`
      :`<input class="quick-sheet-input" id="qs-${field.id}" value="${esc(field.value||'')}" placeholder="${esc(field.placeholder||'')}" ${field.inputType?`type="${field.inputType}"`:'type="text"'}>`;
    return `<div class="quick-sheet-field"><label>${esc(field.label||field.id)}</label>${input}</div>`;
  }).join('')+(config.hideFooter?'':`<div class="quick-sheet-actions"><button type="button" class="quick-sheet-btn" onclick="closeQuickSheet()">${esc(config.cancelLabel||'Cancel')}</button><button type="button" class="quick-sheet-btn ${config.submitTone==='danger'?'danger':'primary'}" onclick="submitQuickSheet()">${esc(config.submitLabel||'Save')}</button></div>`);
  document.getElementById('quick-sheet').classList.add('open');
  form.querySelectorAll('.quick-sheet-input,.quick-sheet-textarea').forEach(input=>{
    input.addEventListener('keydown',event=>{
      const isTextarea=input.classList.contains('quick-sheet-textarea');
      if(event.key==='Enter' && (!isTextarea || event.ctrlKey || event.metaKey)){
        event.preventDefault();
        submitQuickSheet();
      }
    });
  });
  setTimeout(()=>document.querySelector('#quick-sheet .quick-sheet-input, #quick-sheet .quick-sheet-textarea')?.focus(),10);
}
function closeQuickSheet(skipCancel=false){
  document.getElementById('quick-sheet').classList.remove('open');
  const state=quickSheetState;
  quickSheetState=null;
  if(!skipCancel&&state?.onCancel)state.onCancel();
}
function collectQuickSheetValues(){
  const values={};
  for(const field of quickSheetState?.fields||[]){
    if(field.type)continue;
    values[field.id]=(document.getElementById(`qs-${field.id}`)?.value||'').trim();
  }
  return values;
}
async function runQuickSheetAction(fieldId,actionId){
  if(!quickSheetState)return;
  const field=(quickSheetState.fields||[]).find(item=>item.id===fieldId && item.type==='action-grid');
  const action=(field?.actions||[]).find(item=>(item.id||item.label||'action')===actionId);
  if(!action?.onClick)return;
  try{
    closeQuickSheet(true);
    await action.onClick(collectQuickSheetValues());
  }catch(e){
    console.error('Quick sheet action failed',e);
    showNotif(e?.message||'Action failed');
  }
}
async function submitQuickSheet(){
  if(!quickSheetState || quickSheetState.submitting)return;
  const values=collectQuickSheetValues();
  const handler=quickSheetState.onSubmit;
  quickSheetState.submitting=true;
  try{
    if(handler)await handler(values);
    closeQuickSheet(true);
  }catch(e){
    console.error('Quick sheet submit failed',e);
    showNotif(e?.message||'Action failed');
  }finally{
    if(quickSheetState)quickSheetState.submitting=false;
  }
}
function confirmSheet({title,subtitle,confirmLabel='Confirm',tone='danger'}){
  return new Promise(resolve=>{
    openQuickSheet({
      title,
      subtitle,
      fields:[],
      submitLabel:confirmLabel,
      submitTone:tone,
      cancelLabel:'Cancel',
      onCancel:()=>resolve(false),
      onSubmit:async()=>resolve(true)
