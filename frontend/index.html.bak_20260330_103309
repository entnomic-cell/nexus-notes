function renderMindmap(){
  const svg=document.getElementById('mindmap-svg');
  const nodesCont=document.getElementById('mindmap-nodes');
  const canvas=document.getElementById('mindmap-canvas');
  const metrics=getMmNodeMetrics();
  const {visible,visibleNodes,visibleEdges}=mmVisibleGraph();
  document.documentElement.style.setProperty('--mm-node-font-size',`${parseInt(mmMeta.fontSize,10)||14}px`);
  applyMindmapCanvasStyle(canvas);
  mmSyncToolbar();
  svg.innerHTML=visibleEdges.map(buildMmEdgeMarkup).join('');
  nodesCont.innerHTML=visibleNodes.map(n=>{
    const shapeClass=`mm-node-${n.shape||'ellipse'}`;
    const hasChildren=mmChildrenOf(n.id).some(childId=>visible.has(childId));
    const mutedClass=mmMeta.focusNodeId && mmMeta.focusNodeId!==n.id ? 'is-focus-muted' : '';
    const styleClass=n.labelStyle==='emphasis'?'mm-node-emphasis':(n.labelStyle==='soft'?'mm-node-soft':'');
    return `<div class="mm-node ${shapeClass} ${styleClass} ${mutedClass} ${mmSelected===n.id?'selected':''}"
      id="mmn-${n.id}"
      style="left:${n.x-metrics.width/2}px;top:${n.y-metrics.height/2}px;width:${metrics.width}px;min-height:${metrics.height}px;background:${n.color}22;color:${n.color};border:2px solid ${n.color};"
      onmousedown="mmNodeMousedown(event,'${n.id}')"
      onclick="mmNodeClick(event,'${n.id}')">
      ${hasChildren?`<button class="mm-collapse-chip" onclick="event.stopPropagation();mmToggleCollapse('${n.id}')">${n.collapsed?'+':'–'}</button>`:''}
      ${mmMeta.focusNodeId===n.id?`<div class="mm-focus-badge">Focus</div>`:''}
      <input value="${esc(n.text)}" onfocus="mmBeginTextEdit('${n.id}')" onblur="mmFinishTextEdit('${n.id}')" oninput="mmUpdateText('${n.id}',this.value)" onclick="event.stopPropagation()" style="color:${n.color}">
    </div>`;
  }).join('');
  visibleNodes.forEach(n=>{
    const el=document.getElementById(`mmn-${n.id}`);
    if(el)makeMmDraggable(el,n);
  });
}

function mmUpdateText(id,text){
  const n=mmNodes.find(n=>n.id===id);if(n)n.text=text;
}
function mmBeginTextEdit(id){
  mmSelected=id;
  mmTextEditSnapshot=JSON.stringify(mmCloneState());
  mmSyncToolbar();
}
function mmFinishTextEdit(id){
  const current=JSON.stringify(mmCloneState());
  if(mmTextEditSnapshot && current!==mmTextEditSnapshot){
    mmRememberState();
  }
  mmTextEditSnapshot=null;
}

function mmNodeClick(e,id){
  if(mmConnecting){
    if(!mmConnectFrom){mmConnectFrom=id;showNotif('Now click the target node');}
    else if(mmConnectFrom!==id){
      mmEdges=mmNormalizeEdges([...mmEdges,{from:mmConnectFrom,to:id}]);
      mmConnectFrom=null;
      mmCommitChange({autoLayout:mmMeta.layoutMode==='tree'});
    }
    return;
  }
  mmSelected=mmSelected===id?null:id;
  renderMindmap();
}

function mmNodeMousedown(e,id){
  mmSelected=id;
  e.stopPropagation();
  mmSyncToolbar();
}

function makeMmDraggable(el,node){
  el.addEventListener('mousedown',e=>{
    if(e.target.tagName==='INPUT')return;
    mmSelected=node.id;
    mmDragState={id:node.id,offsetX:e.clientX-node.x,offsetY:e.clientY-node.y,hoverTarget:null};
    e.preventDefault();
    const onMove=moveEvent=>{
      if(!mmDragState || mmDragState.id!==node.id)return;
      node.x=moveEvent.clientX-mmDragState.offsetX;
      node.y=moveEvent.clientY-mmDragState.offsetY;
      el.style.left=(node.x-getMmNodeMetrics().width/2)+'px';
      el.style.top=(node.y-getMmNodeMetrics().height/2)+'px';
      const hovered=moveEvent.target?.closest?.('.mm-node');
      mmDragState.hoverTarget=hovered?.id?.replace('mmn-','')||null;
      renderMmEdgesOnly();
    };
    const onUp=()=>{
      if(!mmDragState || mmDragState.id!==node.id)return;
      const targetId=mmDragState.hoverTarget;
      const draggedId=mmDragState.id;
      mmDragState=null;
      document.removeEventListener('mousemove',onMove);
      document.removeEventListener('mouseup',onUp);
      if(targetId && targetId!==draggedId && mmMeta.dragReparent){
        if(mmReparentNode(draggedId,targetId)){
          mmSelected=draggedId;
          mmCommitChange({autoLayout:true});
          return;
        }
      }
      if(mmMeta.layoutMode==='tree'){
        mmCommitChange({autoLayout:true});
      }else{
        renderMindmap();
        mmRememberState();
      }
    };
    document.addEventListener('mousemove',onMove);
    document.addEventListener('mouseup',onUp);
  },{once:true});
}

function renderMmEdgesOnly(){
  const {visibleEdges}=mmVisibleGraph();
  const svg=document.getElementById('mindmap-svg');
  svg.innerHTML=visibleEdges.map(buildMmEdgeMarkup).join('');
}

function mmToggleCollapse(nodeId=mmSelected){
  const node=mmNodes.find(item=>item.id===nodeId);
  if(!node)return;
  node.collapsed=!node.collapsed;
  if(mmMeta.focusNodeId && node.collapsed && mmDescendantsOf(nodeId).has(mmMeta.focusNodeId)){
    mmMeta.focusNodeId=nodeId;
  }
  mmCommitChange({autoLayout:mmMeta.layoutMode==='tree'});
}
function mmToggleSelectedCollapse(){mmToggleCollapse(mmSelected);}
function mmToggleFocus(nodeId=mmSelected){
  if(!nodeId)return;
  mmMeta.focusNodeId=mmMeta.focusNodeId===nodeId?'':nodeId;
  mmCommitChange({autoLayout:mmMeta.layoutMode==='tree'||!!mmMeta.focusNodeId});
}
function mmClearFocus(){
  if(!mmMeta.focusNodeId)return;
  mmMeta.focusNodeId='';
  mmCommitChange({autoLayout:mmMeta.layoutMode==='tree'});
}
function mmAutoArrange(){
  mmMeta.layoutMode='tree';
  mmMeta.autoLayout=true;
  mmCommitChange({autoLayout:true});
}
function mmApplySelectedStyle(key,value){
  const node=mmNodes.find(item=>item.id===mmSelected);
  if(!node)return;
  if(key==='shape')node.shape=value;
  if(key==='labelStyle')node.labelStyle=value;
  renderMindmap();
  mmRememberState();
}
function mmSiblingIds(nodeId){
  const parent=mmParentOf(nodeId);
  if(!parent)return mmNodes.filter(node=>!mmParentOf(node.id)).map(node=>node.id);
  return mmChildrenOf(parent);
}
function mmMoveSelection(direction){
  if(!mmSelected && mmNodes.length){
    mmSelected=mmNodes[0].id;
    renderMindmap();
    return true;
  }
  if(!mmSelected)return false;
  let targetId='';
  if(direction==='left')targetId=mmParentOf(mmSelected)||'';
  else if(direction==='right')targetId=mmChildrenOf(mmSelected)[0]||'';
  else {
    const siblings=mmSiblingIds(mmSelected);
    const idx=siblings.indexOf(mmSelected);
    if(idx>=0)targetId=direction==='up'?(siblings[idx-1]||''):(siblings[idx+1]||'');
  }
  if(!targetId)return false;
  mmSelected=targetId;
  renderMindmap();
  return true;
}
function mmHandleKeydown(e){
  if(!document.getElementById('mindmap-view')?.classList.contains('open'))return false;
  const target=e.target;
  const targetTag=(target?.tagName||'').toUpperCase();
  const typingField=targetTag==='INPUT' || targetTag==='TEXTAREA' || target?.isContentEditable;
  const meta=e.metaKey||e.ctrlKey;
  if(meta && e.key.toLowerCase()==='z'){
    e.preventDefault();
    if(e.shiftKey)mmRedo(); else mmUndo();
    return true;
  }
  if(typingField && !['Escape'].includes(e.key))return false;
  if(e.key==='ArrowLeft'){e.preventDefault();return mmMoveSelection('left');}
  if(e.key==='ArrowRight'){e.preventDefault();return mmMoveSelection('right');}
  if(e.key==='ArrowUp'){e.preventDefault();return mmMoveSelection('up');}
  if(e.key==='ArrowDown'){e.preventDefault();return mmMoveSelection('down');}
  if(e.key==='Tab'){e.preventDefault();mmAddChild();return true;}
  if(e.key==='Enter'){e.preventDefault();mmAddNode();return true;}
  if(e.key==='Delete' || e.key==='Backspace'){e.preventDefault();mmDeleteSelected();return true;}
  if(e.key===' '){e.preventDefault();mmToggleSelectedCollapse();return true;}
  if(e.key.toLowerCase()==='f'){e.preventDefault();mmToggleFocus();return true;}
  if(e.key==='Escape'){
    const handled=!!(mmConnectFrom || mmConnecting || mmMeta.focusNodeId || mmSelected);
    mmConnectFrom=null;
    mmConnecting=false;
    mmMeta.focusNodeId='';
    mmSelected=null;
    mmSyncToolbar();
    if(handled){e.preventDefault();renderMindmap();return true;}
  }
  return false;
}

