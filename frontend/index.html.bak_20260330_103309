.docs-section{padding:20px;border-radius:20px;border:1px solid rgba(255,255,255,0.07);background:linear-gradient(180deg,rgba(255,255,255,0.05),rgba(255,255,255,0.02));}
.docs-section h3{margin:0 0 10px;font-size:20px;font-weight:800;letter-spacing:-.04em;color:#f4f7ff;}
.docs-section p{margin:0 0 12px;font-size:13px;line-height:1.8;color:#c2cee3;}
