            <button class="cal-card-btn" onclick="deleteCalendarEvent('${eventItem.id}')">Delete</button>
          </div>
        </div>
      `).join('') : `<div class="cal-empty">No events on this day yet. Add one here and it stays in Nexus.</div>`}
    </div>
    <div class="cal-detail-section">
      <div class="cal-detail-section-title">Notes</div>
      ${dayNotes.length ? dayNotes.map(note=>`
        <div class="cal-note-card">
