function cmdKeydown(e){
  const items=document.querySelectorAll('#cmd-results .cmd-item');
  if(e.key==='ArrowDown'){e.preventDefault();cmdSelected=Math.min(cmdSelected+1,items.length-1);items.forEach((el,i)=>el.classList.toggle('sel',i===cmdSelected));}
  else if(e.key==='ArrowUp'){e.preventDefault();cmdSelected=Math.max(cmdSelected-1,0);items.forEach((el,i)=>el.classList.toggle('sel',i===cmdSelected));}
  else if(e.key==='Enter'){items[cmdSelected]?.click();}
  else if(e.key==='Escape'){closeCmdPalette();}
}

