function mmCloneState(){
  return JSON.parse(JSON.stringify({nodes:mmNodes,edges:mmEdges,meta:mmMeta,selected:mmSelected,nodeCount:mmNodeCount}));
}
function mmNormalizeNode(node,index=0){
  const fallbackX=180 + (index%4)*180;
  const fallbackY=160 + Math.floor(index/4)*120;
  return {
    id:String(node?.id||index+1),
    text:String(node?.text||'New Node'),
    x:Number.isFinite(Number(node?.x))?Number(node.x):fallbackX,
    y:Number.isFinite(Number(node?.y))?Number(node.y):fallbackY,
    color:String(node?.color||'#c8a96e'),
    shape:['ellipse','rect','diamond'].includes(node?.shape)?node.shape:'ellipse',
    collapsed:!!node?.collapsed,
    labelStyle:['normal','emphasis','soft'].includes(node?.labelStyle)?node.labelStyle:'normal'
  };
}
function mmNormalizeEdges(edges){
  const dedupe=new Set();
  return (Array.isArray(edges)?edges:[]).map(edge=>({
    from:String(edge?.from||''),
    to:String(edge?.to||'')
  })).filter(edge=>{
    if(!edge.from||!edge.to||edge.from===edge.to)return false;
    const key=`${edge.from}=>${edge.to}`;
    if(dedupe.has(key))return false;
    dedupe.add(key);
    return true;
  });
}
function mmNormalizeMeta(meta){
  return {...mmDefaultMeta(),...(meta&&typeof meta==='object'?meta:{})};
}
function mmLoadState(state){
  mmNodes=(state?.nodes||[]).map(mmNormalizeNode);
  mmEdges=mmNormalizeEdges(state?.edges||[]).filter(edge=>mmNodes.some(node=>node.id===edge.from)&&mmNodes.some(node=>node.id===edge.to));
  mmMeta=mmNormalizeMeta(state?.meta||{});
  mmSelected=state?.selected && mmNodes.some(node=>node.id===state.selected)?state.selected:null;
  mmNodeCount=Math.max(mmNodes.length, ...(mmNodes.map(node=>parseInt(node.id,10)).filter(Number.isFinite)), 1);
}
function mmResetHistory(){
  mmHistory=[mmCloneState()];
  mmHistoryIndex=0;
}
function mmRememberState(){
  const snapshot=mmCloneState();
  const encoded=JSON.stringify(snapshot);
  const current=mmHistory[mmHistoryIndex]?JSON.stringify(mmHistory[mmHistoryIndex]):'';
  if(encoded===current)return;
  mmHistory=mmHistory.slice(0,mmHistoryIndex+1);
  mmHistory.push(snapshot);
  mmHistoryIndex=mmHistory.length-1;
}
function mmUndo(){
  if(mmHistoryIndex<=0)return;
  mmHistoryIndex-=1;
  mmLoadState(mmHistory[mmHistoryIndex]);
  renderMindmap();
}
function mmRedo(){
  if(mmHistoryIndex>=mmHistory.length-1)return;
  mmHistoryIndex+=1;
  mmLoadState(mmHistory[mmHistoryIndex]);
  renderMindmap();
}
function mmChildrenMap(){
  const map=new Map();
  mmEdges.forEach(edge=>{
    if(!map.has(edge.from))map.set(edge.from,[]);
    map.get(edge.from).push(edge.to);
  });
  return map;
}
function mmParentMap(){
  const map=new Map();
  mmEdges.forEach(edge=>{
    if(!map.has(edge.to))map.set(edge.to,edge.from);
  });
  return map;
}
function mmParentOf(nodeId){
  return mmParentMap().get(nodeId)||null;
}
function mmChildrenOf(nodeId){
  return mmChildrenMap().get(nodeId)||[];
}
function mmDescendantsOf(nodeId){
  const children=mmChildrenMap();
  const seen=new Set();
  const stack=[nodeId];
  while(stack.length){
    const current=stack.pop();
    (children.get(current)||[]).forEach(child=>{
      if(seen.has(child))return;
      seen.add(child);
      stack.push(child);
    });
  }
  return seen;
}
function mmVisibleGraph(){
  const visible=new Set(mmNodes.map(node=>node.id));
  if(mmMeta.focusNodeId && mmNodes.some(node=>node.id===mmMeta.focusNodeId)){
    visible.clear();
    visible.add(mmMeta.focusNodeId);
    mmDescendantsOf(mmMeta.focusNodeId).forEach(id=>visible.add(id));
  }
  if(mmMeta.collapseBranches){
    mmNodes.forEach(node=>{
      if(!node.collapsed || !visible.has(node.id))return;
      mmDescendantsOf(node.id).forEach(id=>visible.delete(id));
    });
  }
  return {
    visible,
    visibleNodes:mmNodes.filter(node=>visible.has(node.id)),
    visibleEdges:mmEdges.filter(edge=>visible.has(edge.from)&&visible.has(edge.to))
  };
}
function mmSyncToolbar(){
  const selected=mmNodes.find(node=>node.id===mmSelected)||null;
  const setValue=(id,value)=>{ const el=document.getElementById(id); if(el && value!=null)el.value=String(value); };
  setValue('mm-node-size',mmMeta.nodeSize);
  setValue('mm-font-size',mmMeta.fontSize);
  setValue('mm-edge-style',mmMeta.edgeStyle);
  setValue('mm-background-style',mmMeta.background);
  setValue('mm-layout-mode',mmMeta.layoutMode);
  setValue('mm-node-style',selected?.labelStyle||mmMeta.nodeStyle||'normal');
  setValue('mm-node-shape',selected?.shape||'ellipse');
  const color=selected?.color||'#c8a96e';
  const colorBtn=document.getElementById('mm-node-color-btn');
  if(colorBtn)colorBtn.dataset.color=color;
  const colorBar=document.getElementById('mm-node-color-bar');
  if(colorBar)colorBar.style.background=color;
  document.getElementById('mm-connect-btn')?.classList.toggle('primary',mmConnecting);
  document.getElementById('mm-layout-btn')?.classList.toggle('active',mmMeta.layoutMode==='tree');
  document.getElementById('mm-focus-btn')?.classList.toggle('active',!!mmMeta.focusNodeId);
  const collapseBtn=document.getElementById('mm-collapse-btn');
  if(collapseBtn)collapseBtn.textContent=selected?.collapsed?'Expand':'Collapse';
  document.getElementById('mm-undo-btn')?.classList.toggle('active',mmHistoryIndex>0);
  document.getElementById('mm-redo-btn')?.classList.toggle('active',mmHistoryIndex<mmHistory.length-1);
}
function mmApplyAutoLayout(rootId=''){
  const {visibleNodes,visibleEdges}=mmVisibleGraph();
  if(!visibleNodes.length)return;
  const parentMap=new Map();
  const childMap=new Map();
  visibleEdges.forEach(edge=>{
    if(!childMap.has(edge.from))childMap.set(edge.from,[]);
    childMap.get(edge.from).push(edge.to);
    if(!parentMap.has(edge.to))parentMap.set(edge.to,edge.from);
  });
  let roots=[];
  if(rootId && visibleNodes.some(node=>node.id===rootId))roots=[rootId];
  else roots=visibleNodes.filter(node=>!parentMap.has(node.id)).map(node=>node.id);
  if(!roots.length)roots=[visibleNodes[0].id];
  const spacingX=230;
  const spacingY=110;
  let leafCursor=0;
  const positions=new Map();
  const nextY=()=>140 + leafCursor++*spacingY;
  const placeNode=(nodeId,depth)=>{
    const kids=(childMap.get(nodeId)||[]).filter((child,idx,arr)=>arr.indexOf(child)===idx);
    if(!kids.length){
      const y=nextY();
      positions.set(nodeId,{x:140 + depth*spacingX,y});
      return y;
    }
    const childYs=kids.map(child=>placeNode(child,depth+1));
    const y=(childYs[0]+childYs[childYs.length-1])/2;
    positions.set(nodeId,{x:140 + depth*spacingX,y});
    return y;
  };
  roots.forEach((root,index)=>{
    if(index>0)leafCursor+=1;
    placeNode(root,0);
  });
  mmNodes=mmNodes.map(node=>positions.has(node.id)?{...node,...positions.get(node.id)}:node);
}
function mmReparentNode(childId,parentId){
  if(!childId||!parentId||childId===parentId)return false;
  if(mmDescendantsOf(childId).has(parentId))return false;
  mmEdges=mmEdges.filter(edge=>edge.to!==childId);
  mmEdges.push({from:parentId,to:childId});
  mmEdges=mmNormalizeEdges(mmEdges);
  return true;
}
function mmCommitChange(opts={}){
  if(opts.autoLayout || mmMeta.layoutMode==='tree'){
    mmApplyAutoLayout(mmMeta.focusNodeId||'');
  }
  renderMindmap();
  mmRememberState();
}

