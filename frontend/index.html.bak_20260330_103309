function addFolderToCache(name){
  const normalized=String(name||'').trim();
  if(!normalized)return;
  optimisticFolders.add(normalized.toLowerCase());
  if(folderCache.some(folder=>String(folder.folder||'').toLowerCase()===normalized.toLowerCase()))return;
  folderCache=[...folderCache,{folder:normalized,count:0}].sort((a,b)=>{
    const order=name=>{
      if(name==='Notes')return 0;
      if(name==='Inbox')return 1;
      return 2;
    };
    const left=String(a.folder||'');
    const right=String(b.folder||'');
    const orderDiff=order(left)-order(right);
    return orderDiff || left.localeCompare(right,undefined,{sensitivity:'base'});
  });
  paintFolderList();
}

async function renderFolders(){
  const fetched=await api('GET','/folders');
  const merged=[...(Array.isArray(fetched)?fetched:[])];
  optimisticFolders.forEach(lowerName=>{
    if(!merged.some(folder=>String(folder.folder||'').toLowerCase()===lowerName)){
      const match=folderCache.find(folder=>String(folder.folder||'').toLowerCase()===lowerName);
      merged.push({folder:match?.folder||lowerName,count:match?.count||0});
    }
  });
  folderCache=merged.sort((a,b)=>{
    const order=name=>{
      if(name==='Notes')return 0;
      if(name==='Inbox')return 1;
      return 2;
    };
    const left=String(a.folder||'');
    const right=String(b.folder||'');
    const orderDiff=order(left)-order(right);
    return orderDiff || left.localeCompare(right,undefined,{sensitivity:'base'});
  });
  paintFolderList();
  const inbox=folderCache.find(folder=>String(folder.folder||'').toLowerCase()==='inbox');
  const inboxBadge=document.getElementById('inbox-badge');
  if(inboxBadge)inboxBadge.textContent=inbox?.count ?? 0;
}
