.docs-header-title{font-size:18px;font-weight:700;color:#f4f7ff;}
.docs-header-sub{font-size:12px;color:#9fb0cf;margin-top:4px;}
.docs-scroll{padding:22px;overflow:auto;display:grid;gap:18px;min-height:0;}
