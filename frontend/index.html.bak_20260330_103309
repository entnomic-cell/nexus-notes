  ctx.strokeRect(12,12,metrics.width-24,metrics.height-24);
  ctx.setLineDash([]);
  ctx.fillText(`debug · strokes ${block.strokes.length} · zoom ${ptViewport.zoom.toFixed(2)}`,18,28);
